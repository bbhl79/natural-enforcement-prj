{
  // integration 层独立类型检查配置（dev test integration 容器内执行 tsc -p integration）。
  // 不并入根 tsconfig：根 unit 层无库且无生成的 Prisma Client，两边互不污染。
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  // 根配置的 exclude 会被继承，且优先于下面的 include。这里重置为空，
  // 让根配置排除的 main.ts、bootstrap-command.ts 在本层确实参与类型检查。
  "exclude": [],
  "include": [
    "./**/*.ts",
    "../backend/prisma/**/*.ts",
    "../backend/server/src/main.ts",
    "../backend/server/src/persistence.module.ts",
    "../backend/server/src/bootstrap-command.ts"
  ]
}
