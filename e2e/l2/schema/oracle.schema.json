{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e2e/l2/schema/oracle.schema.json",
  "title": "L2Oracle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "caseId",
    "legalExit",
    "legalRefs",
    "asserts",
    "halfRunPolicy"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^L2-ORACLE-" },
    "caseId": { "type": "string", "pattern": "^L2-CASE-" },
    "legalExit": { "type": "string", "pattern": "^EXIT-" },
    "legalRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "id"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["CRIT", "DEC", "PROC", "STATE", "UNSPEC"]
          },
          "id": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "asserts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "expect", "provenance"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "enum": ["state", "field", "permission", "timeline", "negative", "http"]
          },
          "path": { "type": "string" },
          "op": {
            "type": "string",
            "enum": ["eq", "in", "includes", "gt", "lt"]
          },
          "expect": {},
          "provenance": { "type": "string", "enum": ["derived", "mocked"] }
        }
      }
    },
    "halfRunPolicy": {
      "type": "string",
      "enum": ["gap-not-reached", "gap-assert-failed"]
    },
    "notes": { "type": "string" }
  }
}
