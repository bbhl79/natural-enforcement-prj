{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "e2e/l2/schema/case.schema.json",
  "title": "L2Case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "seedId",
    "edgeClass",
    "matrixCellId",
    "domain",
    "sourceCode",
    "sourceClass",
    "approvalTier",
    "lineage",
    "steps",
    "oracleId",
    "g6Disposition",
    "harnessCapability",
    "mockRatio"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^L2-CASE-" },
    "seedId": { "type": "string", "minLength": 1 },
    "edgeClass": {
      "type": "string",
      "enum": ["happy", "E1", "E2", "E3", "E4", "E5", "E6"]
    },
    "matrixCellId": { "type": "string", "pattern": "^MC-" },
    "domain": {
      "type": "string",
      "enum": ["land", "mineral", "survey", "planning"]
    },
    "sourceCode": { "type": "string", "minLength": 1 },
    "sourceClass": {
      "type": "string",
      "enum": ["1", "3", "5", "21", "22"]
    },
    "approvalTier": {
      "type": "string",
      "enum": ["none", "approval-only", "approval+consult", "with-rework"]
    },
    "lineage": {
      "type": "object",
      "required": ["fields"],
      "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/lineageField" }
        }
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action", "expectReachable"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "action": { "type": "string" },
          "inputsRef": { "type": "string" },
          "expectReachable": { "type": "boolean" }
        }
      }
    },
    "oracleId": { "type": "string", "pattern": "^L2-ORACLE-" },
    "g6Disposition": {
      "type": "string",
      "enum": ["reject-generate", "gap", "not-reached", "n/a-negative", "admit-ok"]
    },
    "harnessCapability": {
      "type": "string",
      "enum": ["wired", "partial", "unwired", "latent", "missing"]
    },
    "panelMinutesId": { "type": "string" },
    "mockRatio": { "type": "number", "minimum": 0, "maximum": 1 },
    "capabilityId": { "type": "string", "minLength": 1 },
    "verifyScenarioRef": { "type": "string" },
    "notes": { "type": "string" }
  },
  "$defs": {
    "lineageField": {
      "type": "object",
      "required": ["path", "provenance", "value"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "provenance": { "type": "string", "enum": ["derived", "mocked"] },
        "value": {},
        "seedPath": { "type": "string" },
        "mockBasis": {
          "type": "object",
          "required": ["product", "legal"],
          "additionalProperties": false,
          "properties": {
            "product": { "type": "string", "minLength": 1 },
            "legal": {
              "type": "object",
              "required": ["kind", "id"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": ["CRIT", "DEC", "PROC", "STATE", "UNSPEC"]
                },
                "id": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
