{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "@ne/tsconfig 全仓 ESM 基线（TS 6 语义从零编写，规避 TS7 移除项）",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2025",
    "lib": ["es2025"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true
  }
}
