#!/usr/bin/env bash
# 唯一本地入口。up／down／health 走容器；其余已约定子命令仍以非 0 退出。
set -euo pipefail

cd "$(dirname "$0")"
# shellcheck source=dev.d/compose.sh
source dev.d/compose.sh

usage() {
  cat >&2 <<'EOF'
./dev — 唯一本地入口
已实现：up、down、health。其余已约定子命令以非 0 退出。不要另开旁路。

  up
  down
  health backend|frontend|db|minio|doc-render
  db migrate
  lint
  test unit
  build backend|frontend
  check shield|secrets

档位：GZGT_PROFILE=dev（默认，开发档）或 integration（联调档）。
EOF
}

unimplemented() {
  echo "./dev: 未实现: $*" >&2
  exit 1
}

reject() {
  echo "./dev: $*" >&2
  usage
  exit 2
}

require_docker() {
  if ! command -v docker >/dev/null 2>&1; then
    echo "./dev: 需要容器运行时（docker compose）" >&2
    exit 1
  fi
}

if [[ $# -lt 1 ]]; then
  reject "缺少子命令"
fi

cmd=$1
shift

case "$cmd" in
  up)
    [[ $# -eq 0 ]] || reject "up 不接受参数"
    require_docker
    dev.d/up.sh
    ;;
  down)
    [[ $# -eq 0 ]] || reject "down 不接受参数"
    require_docker
    compose down --remove-orphans
    ;;
  health)
    [[ $# -eq 1 ]] || reject "health 需要一个目标"
    require_docker
    case "$1" in
      backend | frontend | db | minio | doc-render) dev.d/health.sh "$1" ;;
      *) reject "未知 health 目标: $1" ;;
    esac
    ;;
  db)
    [[ $# -eq 1 && "$1" == "migrate" ]] || reject "db 仅约定 migrate"
    unimplemented db migrate
    ;;
  lint)
    [[ $# -eq 0 ]] || reject "lint 不接受参数"
    unimplemented lint
    ;;
  test)
    [[ $# -eq 1 && "$1" == "unit" ]] || reject "test 仅约定 unit"
    unimplemented test unit
    ;;
  build)
    [[ $# -eq 1 ]] || reject "build 需要一个目标"
    case "$1" in
      backend | frontend) unimplemented build "$1" ;;
      *) reject "未知 build 目标: $1" ;;
    esac
    ;;
  check)
    [[ $# -eq 1 ]] || reject "check 需要一个目标"
    case "$1" in
      shield) dev.d/check-shield.sh ;;
      secrets) unimplemented check secrets ;;
      *) reject "未知 check 目标: $1" ;;
    esac
    ;;
  *)
    reject "未知子命令: $cmd"
    ;;
esac
