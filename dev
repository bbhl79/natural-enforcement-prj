NGINX_IMAGE='nginx:1.29.8@sha256:1881968aff6f7cdcc4b888c00a11f4ce241ad7ec957e0cb4a9e19e93a3ff87ea'
# 前端本地镜像（#56：dev build 构建，Dockerfile 入库；compose 只按 image 引用 + pull_policy never）
FRONTEND_IMAGE='natural-enforcement/frontend:dev'
# HTTP 进程本地镜像（ADR 0004：dev build 构建；容器内 3000，不映射宿主）
SERVER_IMAGE='natural-enforcement/server:dev'
# 宿主 nginx 本地镜像（default.conf 经 Dockerfile COPY；compose 只按 image 引用）
NGINX_DEV_IMAGE='natural-enforcement/nginx:dev'
# localhost 证书在仓库外（#94 / #80 开发侧）。dev up 生成后 tar 灌进命名卷 nginx-certs；
# 宿主目录仍保留供 curl --cacert；compose 不再 bind 该路径（Podman machine 下 WSL home 不可见）。
DEV_CERT_DIR="${HOME}/.local/share/natural-enforcement/dev-certs"
export NE_DEV_CERT_DIR="$DEV_CERT_DIR"
HTTPS_PORT="$NGINX_PORT"
PAGE_URL="https://localhost:${HTTPS_PORT}/"
API_HEALTH_URL="https://localhost:${HTTPS_PORT}/api/health"
# dev db 容器网络内连接串（分项来自 infra/runtime.env 或环境注入；
# CI 模式凭据必须来自环境注入——见 cmd_check 的 --ci 语义）
DB_USER="$POSTGRES_USER"
DB_PASS="$POSTGRES_PASSWORD"
DB_NAME="$POSTGRES_DB"
# 集成测试复制源（#93）。开发库仍是 DB_NAME，测试不复制它。
IT_TEMPLATE_DB="it_template"
# 用户名、密码、库名按 URI 组件编码后再拼进连接串。CI secret 里的 @ : / # 不能当分隔符。
percent_encode() {
  printf '%s' "$1" | od -An -tx1 | awk '{
    for (i = 1; i <= NF; i++) {
      c = strtonum("0x" $i)
      if ((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 45 || c == 46 || c == 95 || c == 126)
        printf "%c", c
      else
        printf "%%%s", toupper($i)
    }
  }'
}
export DATABASE_URL="postgresql://$(percent_encode "$DB_USER"):$(percent_encode "$DB_PASS")@${POSTGRES_HOST}:5432/$(percent_encode "$DB_NAME")"
# 队列连接串：compose 网络内经服务名访问（ADR 0008：由 dev 从清单分项算出）
export REDIS_URL="redis://${REDIS_HOST}:6379"

# 容器内工具链缓存（命名卷，依赖只进容器/卷，不入库）：
# - corepack 卷：缓存 pnpm 二进制（/root/.cache/node/corepack），免去每次容器现下载；
# - pnpm-cache 卷：挂到 pnpm 默认缓存位 /root/.cache/pnpm，registry 元数据与
#   pnpm 12 供应链策略校验结果由此跨容器持久化（实测冷校验 335 条约 1 分钟，热运行 <5s）。
# 注意：pnpm 12 的 install 解析器不收 --cache-dir（无论等号/空格形式），切勿加回。
# registry 渠道仍默认官方源，境内镜像如需使用属宿主环境配置（dev 不内置、不入库）。
CACHE_VOLUMES=(-v "${PROJECT}-corepack:/root/.cache/node/corepack" -v "${PROJECT}-pnpm-cache:/root/.cache/pnpm")
INSTALL_FLAGS=(--frozen-lockfile --ignore-scripts --config.strict-dep-builds=false --store-dir /pnpm/store --prefer-offline)

# 经 stdin tar 灌源进容器 /work，避免 WSL home → Podman machine 的 bind 只见空目录。
# 排除项对齐 .dockerignore／.gitignore 重产物；node_modules／pnpm store 仍用命名卷。
seed_repo_to_stdin() {
  # ustar：工具链镜像是 alpine BusyBox tar，吃不下 GNU 默认 pax。
  tar -C "$ROOT" --format=ustar \
    --exclude='.git' \
    --exclude='node_modules' \
    --exclude='*/node_modules' \
    --exclude='dist' \
    --exclude='*/dist' \
    --exclude='.run' \
    --exclude='e2e/results' \
    --exclude='coverage' \
    --exclude='*.tsbuildinfo' \
    --exclude='.env' \
    --exclude='.env.local' \
    --exclude='frontend/prototype/admin-console/screens' \
    --exclude='docs/screens' \
    -cf - .
}

