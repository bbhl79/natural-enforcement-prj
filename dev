require_compose_file() {
  if [ ! -f "$COMPOSE_FILE" ]; then
    echo "[FAIL] 未找到编排文件：$COMPOSE_FILE" >&2
    exit 1
  fi
}

# frontend／server 镜像更新时 compose 只重建这两个服务；nginx 进程仍缓存启动时
# 解析的上游 IP（#294），表现为页面与 /api/health 502。若 frontend 或 server
# 的创建时间晚于 nginx 启动时间，强制重建 nginx 以重新解析上游。
# 不改 default.conf（docker／podman resolver 地址不同，不用变量 proxy_pass）。
refresh_nginx_if_upstreams_newer() {
  local nginx_cid frontend_cid server_cid nginx_started fe_created srv_created
  nginx_cid="$("${COMPOSE[@]}" ps -q nginx 2>/dev/null || true)"
  frontend_cid="$("${COMPOSE[@]}" ps -q frontend 2>/dev/null || true)"
  server_cid="$("${COMPOSE[@]}" ps -q server 2>/dev/null || true)"
  [ -n "$nginx_cid" ] && [ -n "$frontend_cid" ] && [ -n "$server_cid" ] || return 0
  nginx_started="$(docker inspect -f '{{.State.StartedAt}}' "$nginx_cid")"
  fe_created="$(docker inspect -f '{{.Created}}' "$frontend_cid")"
  srv_created="$(docker inspect -f '{{.Created}}' "$server_cid")"
  if [[ "$fe_created" > "$nginx_started" ]] || [[ "$srv_created" > "$nginx_started" ]]; then
    echo "dev up：frontend／server 新于 nginx，重建 nginx 以刷新上游解析…"
    "${COMPOSE[@]}" up -d --force-recreate --no-deps --wait --wait-timeout 60 nginx
  fi
}

cmd_up() {
  require_compose_file
  local missing=0 img
  while IFS= read -r img; do
    if ! docker image inspect "$img" >/dev/null 2>&1; then
      echo "镜像缺失：$img"
      missing=1
    fi
  done < <("${COMPOSE[@]}" config --images)
  if [ "$missing" -ne 0 ]; then
    echo "请先执行 dev build 构建镜像（或按 infra/VERSIONS.md 官方名手动拉取）后再 dev up。" >&2
    echo "dev up 不会隐式构建或拉取镜像。" >&2
    exit 1
  fi
  ensure_dev_certs
  seed_nginx_certs_volume
  # --wait：等 db/redis 健康检查通过再返回——迁移/种子要求 db 真正就绪，
  # 冷卷首次 initdb 较慢，不等待会赢不了就绪竞态（#57 回归实测踩中）。
  "${COMPOSE[@]}" up -d --wait --wait-timeout 120
  refresh_nginx_if_upstreams_newer
  echo "dev up：基础设施容器已就绪。检查迁移与种子（幂等，已完成自动跳过）…"
  db_migrate
  db_seed
  echo "dev up：写入面板健康快照（与 dev health 同源，dev health 会刷新）…"
  local failed_items=""
  write_health_snapshot quiet || failed_items="$failed_items 面板快照"
  # 健康检查与快照写入失败都不吞掉（评审必修）：快照能写就照常写，但 up 以非 0 退出，
  # 让「基础设施就绪」这个承诺可被脚本/CI 信赖（失败明细跑一次 dev health 可见）。
  [ "$SVC_STATUS" = fail ] && failed_items="$failed_items 容器存活"
  [ "$DB_STATUS" = fail ] && failed_items="$failed_items 数据库连通"
  [ "$QUEUE_STATUS" = fail ] && failed_items="$failed_items 队列连通"
  [ "$FRONTEND_STATUS" = fail ] && failed_items="$failed_items 前端可访问"
  [ "$API_STATUS" = fail ] && failed_items="$failed_items 接口健康"
  if [ -n "$failed_items" ]; then
    echo "[FAIL] dev up：健康检查存在失败项——$(echo "$failed_items" | xargs | tr ' ' '/')。" >&2
    echo "  面板快照已照常写入；逐项明细运行 dev health 查看。" >&2
    exit 1
  fi
  echo "dev up 完成：迁移与种子就绪，健康检查全绿。"
}

cmd_down() {
  require_compose_file
  "${COMPOSE[@]}" down
  echo "dev down 完成：容器与网络已清理，数据卷保留（毁数入口只有 dev db reset）。"
}

