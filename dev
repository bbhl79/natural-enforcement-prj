#!/usr/bin/env bash
# 自然执法工程 唯一本地开发入口（#46/#47 定案）。
# 命令集逐切片落地：切片01 up/down/health/lint；切片02 新增 db（#49 数据语义）；
# 切片03 新增 test（unit 层）与 lint 结构测试；
# 切片04 结构测试扩为全量七模块依赖矩阵（#51）；
# 切片08（#55）health 四依赖补齐：队列连通改经队列接口真实投递健康检查任务并确认消费
#（packages/queue 探测入口，非裸 redis ping），前端项中性占位；
# 切片09（#56）前端落地：health 前端项改真实检查（面板可访问=绿）并计入红绿，
# 检查结果写入面板快照（frontend 容器命名卷，面板与 dev health 同源）；新增 build（最小形态）。
# 切片10（#57）十命令完备：新增 logs/exec（compose 薄封装）、check（lint+test all+build，
# --ci 凭据注入回收）、test e2e 层（e2e/cases 约定：从零拉起+读写通道+命令冒烟）、
# build 扩为全量（后端编译+全部本地镜像）；全局 --run-id 复现（日志/产物落 .run/<id>/）。
# 评审必修（#61 合并前，路线 A）：check 时序改 build 前置——镜像与编译产物是 lint 与
# 测试层的运行前提（test_e2e 需 infra + frontend 本地镜像，二者皆由 build 产出），build
# 在末位时冷环境结构性跑不到它，dev check --ci 不可能绿；同时 build 承担工具链镜像拉取
#（LINT_IMAGE 不是 compose 服务镜像，compose config --images 遍历覆盖不到，
# 冷环境会死在 require_toolchain_image，CI 加一步 dev build 也救不活）。
# 镜像拉取合并为一次并发批次：工具链镜像与 infra 镜像同批拉取（ensure_images，#174）。
# 退出码只有 0/1，诊断看输出。
set -euo pipefail

# 十命令退出码只有 0/1（#47 US20）。set -e 会把 docker/compose 的 2/125/126/127 原样带出，
# 在进程退出时归一。bash 在 EXIT 陷阱里再 exit 不会重入该陷阱。
normalize_exit_code() {
  local status=$?
  if [ "$status" -ne 0 ]; then
    exit 1
  fi
}
trap normalize_exit_code EXIT

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
