# 容器依赖一律不入库（E6：dev lint 机检兜底的漏入库路径）
node_modules/
.pnpm-store/

# 构建产物（宿主侧产生，gitignore 覆盖）
dist/
coverage/
*.tsbuildinfo

# 运行产物唯一根（不入库）：e2e 用例产物、--run-id 复现目录 e2e/results/<id>/（#57：CI run
# 日志与关键产物）、验证跑次证据 e2e/results/verify-<runId>/、截图 e2e/results/screens/<票>/。
# 入库的测试 fixture 见 e2e/testdata/ 与 e2e/verify/fixtures/。
e2e/results/

# Prisma 生成客户端（backend/prisma/schema.prisma 的 generator client output）：
# 构建产物，容器内由 prisma generate 产出（dev db seed / dev test integration /
# backend/server/Dockerfile），不入库。结构闸按路径排除它——闸用 find 扫盘，不读 gitignore，
# 见 tools/structural-test.sh 的 SCAN_EXCLUDE_GENERATED 注释。
backend/prisma/generated/

# 本机 Claude Code 会话目录（仅本机 .git/info/exclude 忽略过；新克隆需仓库级规则）
.claude/

# 本地环境
.env
.env.local
*.log
.DS_Store

# 原型本地天地图 key（勿入库）
**/tianditu.local.js
**/clue-dispatch/.env.local
