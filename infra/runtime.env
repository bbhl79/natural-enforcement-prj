# 运行参数清单（ADR 0008；细则见 #80 决议）。
# dev、infra/docker-compose.yml、.github/workflows/ci.yml 只引用本文件登记的名字。
# 结构测试 runtime-manifest 核对：compose 与 CI 里出现清单外变量名或字面量密钥，判红。
#
# 写法：
# - 每个变量上一行写一条注解：# @<类别> <必填性>。
# - 变量行写成 NAME=value。值不加引号，不做变量展开。
# - 环境里已有同名变量且非空时，dev 用环境里的值，不用本文件的值。
#
# 类别：
# - param：运行参数（非秘密）。
# - secret：密钥。本文件里的值只是开发与 CI 夹具值。生产由部署环境注入同名变量覆盖。
# - path：文件路径。只登记路径，不登记文件内容。
# - derived：由 dev 从分项算出。本文件不存值，只登记名字，写成 # @derived <必填性> NAME。
#
# 必填性：
# - required：读它的进程缺这一项时启动失败，并说明缺哪一项。
# - optional：只有用到它的命令才读。

# ---------- PostgreSQL ----------
# @param required 数据库用户名
POSTGRES_USER=postgres
# @secret required 数据库口令（开发与 CI 夹具值）
POSTGRES_PASSWORD=postgres
# @param required 库名
POSTGRES_DB=postgres
# @param required 数据库主机名（compose 网络内的服务名）
POSTGRES_HOST=db
# @param required 宿主映射端口（并行工作区可改它错开端口）
POSTGRES_PORT=5432
# @derived required DATABASE_URL 由 dev 从 POSTGRES_USER、POSTGRES_PASSWORD、POSTGRES_HOST、POSTGRES_DB 算出

# ---------- Redis（队列） ----------
# @param required 队列主机名（compose 网络内的服务名）
REDIS_HOST=redis
# @param required 宿主映射端口
REDIS_PORT=6379
# @derived required REDIS_URL 由 dev 从 REDIS_HOST 算出

# ---------- RustFS（对象存储） ----------
# @param optional 对象存储根地址（compose 网络内）
RUSTFS_ENDPOINT=http://rustfs:9000
# @param optional 对象存储区域
RUSTFS_REGION=us-east-1
# @param optional 文件桶名
RUSTFS_BUCKET=ne-files
# @secret required 对象存储访问键（开发与 CI 夹具值）
RUSTFS_ACCESS_KEY=rustfsdev
# @secret required 对象存储秘密键（开发与 CI 夹具值）
RUSTFS_SECRET_KEY=rustfsdev-secret
# @param required 宿主映射端口（S3 接口）
RUSTFS_PORT=9000
# @param required 宿主映射端口（控制台）
RUSTFS_CONSOLE_PORT=9001

# ---------- 空间图层服务地址（#213，ADR 0021） ----------
# 七类核查图层与街道镇边界的空间服务地址。运行参数，由部署环境注入同名变量覆盖。
# 地址不含密钥；服务如需令牌，令牌同样由部署环境注入。
# 未配置即为空：核查时该层判「查不成」（确定性失败，不重试），不冒充查过没有。
# @param optional 永久基本农田图层服务地址
NE_LAYER_URL_PERMANENT_FARMLAND=
# @param optional 生态保护红线图层服务地址
NE_LAYER_URL_ECOLOGICAL_REDLINE=
# @param optional 城镇开发边界图层服务地址
NE_LAYER_URL_URBAN_DEVELOPMENT_BOUNDARY=
# @param optional 耕地图层服务地址
NE_LAYER_URL_CULTIVATED_LAND=
# @param optional 农用地转用审批图层服务地址
NE_LAYER_URL_LAND_CONVERSION_APPROVAL=
# @param optional 建设用地规划许可图层服务地址
NE_LAYER_URL_CONSTRUCTION_LAND_PERMIT=
# @param optional 供地红线图层服务地址
NE_LAYER_URL_LAND_SUPPLY_REDLINE=
# @param optional 街道镇边界图层服务地址（供辖区建议，#214）
NE_LAYER_URL_STREET_BOUNDARY=

# ---------- nginx ----------
# @param required 宿主映射 HTTPS 端口
NGINX_PORT=8080
# @derived required NE_DEV_CERT_DIR 由 dev 指到仓库外的 localhost 证书目录

# ---------- 特性开关 ----------
# @param optional 立案后撞暂存线索提醒（#207 P2；默认关，等立案票一并定）
NE_FEATURE_FILED_REMINDER=

# ---------- 引导命令 ----------
# @path optional 引导口令文件在容器内的路径（只登记路径；口令只从挂载文件或 secret 读入）
BOOTSTRAP_PASSWORD_FILE=/run/secrets/bootstrap-password
