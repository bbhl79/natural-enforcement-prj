{
  "id": "vf-sc-next-todo-buttons",
  "status": "runnable",
  "driver": "api",
  "kind": "happy",
  "strictSteps": true,
  "title": "下一待办按钮：状态加身份，只核已有分派按钮",
  "profileRefs": ["vf-case-02-occupy-without-approval"],
  "identityRefs": ["clerk-a", "intake-a", "intake-st"],
  "featureMapRefs": ["nav.workbench.dispatch.buttons"],
  "steps": [
    {
      "id": "register-pool",
      "action": "register-clue",
      "fromProfile": "vf-case-02-occupy-without-approval",
      "path": "stages.register.system",
      "identityRef": "clerk-a",
      "mutate": {
        "setValues": {
          "clue.narrative": "vf-下一待办按钮：待派机构"
        },
        "overrideSpatial": {
          "type": "Feature",
          "properties": {},
          "geometry": {
            "type": "Polygon",
            "coordinates": [
              [
                [113.801, 23.401],
                [113.809, 23.401],
                [113.809, 23.409],
                [113.801, 23.409],
                [113.801, 23.401]
              ]
            ]
          }
        }
      }
    },
    {
      "id": "buttons-in-pool",
      "action": "read-dispatch-buttons",
      "expectClueStatus": "in_pool",
      "matrix": [
        {
          "identityRef": "clerk-a",
          "http": 200,
          "mayDecide": false,
          "mayAssignOrg": false,
          "mayAssignPeople": false,
          "mayReassignOrg": false
        },
        {
          "identityRef": "intake-a",
          "http": 200,
          "mayDecide": false,
          "mayAssignOrg": true,
          "mayAssignPeople": false,
          "mayReassignOrg": false
        },
        {
          "identityRef": "intake-st",
          "http": 403,
          "reason": "scope-denied"
        }
      ]
    },
    {
      "id": "register-decide",
      "action": "register-clue",
      "fromProfile": "vf-case-02-occupy-without-approval",
      "path": "stages.register.system",
      "identityRef": "clerk-a",
      "mutate": {
        "setValues": {
          "clue.narrative": "vf-下一待办按钮：待分派决定"
        },
        "overrideSpatial": {
          "type": "Feature",
          "properties": {},
          "geometry": {
            "type": "Polygon",
            "coordinates": [
              [
                [113.801, 23.401],
                [113.809, 23.401],
                [113.809, 23.409],
                [113.801, 23.409],
                [113.801, 23.401]
              ]
            ]
          }
        }
      }
    },
    {
      "id": "buttons-pending",
      "action": "read-dispatch-buttons",
      "expectClueStatus": "pending_decision",
      "matrix": [
        {
          "identityRef": "clerk-a",
          "http": 200,
          "mayDecide": true,
          "mayAssignOrg": false,
          "mayAssignPeople": false,
          "mayReassignOrg": false
        },
        {
          "identityRef": "intake-a",
          "http": 200,
          "mayDecide": false,
          "mayAssignOrg": false,
          "mayAssignPeople": false,
          "mayReassignOrg": false
        },
        {
          "identityRef": "intake-st",
          "http": 403,
          "reason": "scope-denied"
        }
      ]
    },
    {
      "id": "register-org",
      "action": "register-clue",
      "fromProfile": "vf-case-02-occupy-without-approval",
      "path": "stages.register.system",
      "identityRef": "clerk-a",
      "mutate": {
        "setValues": {
          "clue.narrative": "vf-下一待办按钮：已派机构"
        },
        "overrideSpatial": {
          "type": "Feature",
          "properties": {},
          "geometry": {
            "type": "Polygon",
            "coordinates": [
              [
                [113.901, 23.501],
                [113.909, 23.501],
                [113.909, 23.509],
                [113.901, 23.509],
                [113.901, 23.501]
              ]
            ]
          }
        }
      }
    },
    {
      "id": "assign-org",
      "action": "assign-org",
      "identityRef": "intake-a",
      "orgUnitCode": "ORG-STATION-A",
      "expectedStatus": "in_pool"
    },
    {
      "id": "buttons-org-assigned",
      "action": "read-dispatch-buttons",
      "expectClueStatus": "org_assigned",
      "matrix": [
        {
          "identityRef": "clerk-a",
          "http": 200,
          "mayDecide": false,
          "mayAssignOrg": false,
          "mayAssignPeople": false,
          "mayReassignOrg": false
        },
        {
          "identityRef": "intake-a",
          "http": 200,
          "mayDecide": false,
          "mayAssignOrg": false,
          "mayAssignPeople": false,
          "mayReassignOrg": true
        },
        {
          "identityRef": "intake-st",
          "http": 403,
          "reason": "scope-denied"
        }
      ]
    }
  ],
  "oracle": {
    "kind": "machine",
    "assert": [
      { "path": "body.result", "op": "eq", "value": "button-matrix" },
      { "path": "body.readScope", "op": "eq", "value": "entered-org-only" },
      { "path": "body.facts.clueStatus", "op": "eq", "value": "org_assigned" },
      { "path": "body.facts.rows.0.identityRef", "op": "eq", "value": "clerk-a" },
      { "path": "body.facts.rows.0.http", "op": "eq", "value": 200 },
      { "path": "body.facts.rows.0.mayAssignPeople", "op": "eq", "value": false },
      { "path": "body.facts.rows.0.mayReassignOrg", "op": "eq", "value": false },
      { "path": "body.facts.rows.1.identityRef", "op": "eq", "value": "intake-a" },
      { "path": "body.facts.rows.1.http", "op": "eq", "value": 200 },
      { "path": "body.facts.rows.1.mayAssignPeople", "op": "eq", "value": false },
      { "path": "body.facts.rows.1.mayReassignOrg", "op": "eq", "value": true },
      { "path": "body.facts.rows.2.identityRef", "op": "eq", "value": "intake-st" },
      { "path": "body.facts.rows.2.http", "op": "eq", "value": 403 },
      { "path": "body.facts.rows.2.reason", "op": "eq", "value": "scope-denied" }
    ]
  },
  "notes": "按钮按现有 affordance。待分派决定的「派出／不派」只归录入人 clerk-a。待派机构的「派出机构」只归录入机构内勤 intake-a。已派机构后，录入人与甲区内勤都没有「派出承办人」；甲区内勤另有「重新分派」（上级内勤）。甲所内勤 intake-st 对这三条 GET /api/clues/:id/dispatch 都是 403 scope-denied：读取仍只按 enteredOrgId。其中已派机构这一条是修前基线，本场景不把读取机构改成 enteredOrgId 与承办机构的并集。工作台清单是否出现该线索只写入证据 listedInAssignView，不写成过滤规则。"
}
