#!/usr/bin/env bash
# git credential helper：git 就 github.com 请求凭据时，把本次 installation token
# 从环境变量转交给 git。token 只来自父进程（devenv git-push）注入的环境，
# 不读文件、不缓存、不记录。无 token 时以非零退出，让 git 失败而不是另寻凭据。
set -euo pipefail
[[ "${1:-}" == "get" ]] || exit 0
[[ -n "${GH_APP_INSTALLATION_TOKEN:-}" ]] || exit 1
printf 'username=x-access-token\npassword=%s\n' "$GH_APP_INSTALLATION_TOKEN"
