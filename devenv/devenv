#!/usr/bin/env bash
# ============================================================================
# devenv —— 工程基座唯一入口（Spec-工程基座 §4；#56 最小空间数据开发栈 + #58 固定快照与不可变绑定 + #59 per-worktree 隔离 + #61 锁与栈使用租约）
#
# 宿主工具链零安装：本脚本只使用白名单宿主工具（bash、docker CLI + compose v2、
# git、coreutils、tar、find、jq、openssl、curl、gh；macOS 自带 bsdtar/BSD find
# 兼容所用法的）；一切 node/pnpm/prisma 执行都在容器内。
#
# 命令面权威文档：devenv/COMMANDS.md（Action | Command | 期望退出码 + JSON schema
# + 并发语义）。AGENTS.md 只放关键入口与指针。
#
# 调用形态：./devenv/devenv [--json] <子命令> [参数]
#
# 输出协议（Spec §4 三类）：
#   - 结构化命令 --json：stdout 单 JSON 或 JSONL 事件流（终值含 command/status/exitCode）；
#     进度与子进程原始输出走 stderr，不混入结果流。
#   - 透传命令（exec/shell/logs）：子进程原始流；--json 仅包装终值元数据。
#
# 退出码枚举（总表归 Spec-工程基座；7–10 e2e 专用码段由 Spec-e2e 登记，本票不用）：
#   0 成功 | 2 用法错误 | 3 环境未就绪（含引擎不在矩阵、端点解析失败）
#   4 任务失败 | 5 超时（健康等待/拉取） | 6 独占锁冲突
#   20 授权不符 | 21 私钥/签名 | 22 token 换取失败 | 23 目标未授权（认证入口）
# ============================================================================
set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/output.sh
source "$REPO_ROOT/devenv/lib/output.sh"
# shellcheck source=lib/engine.sh
source "$REPO_ROOT/devenv/lib/engine.sh"
# shellcheck source=lib/lock.sh
source "$REPO_ROOT/devenv/lib/lock.sh"
# shellcheck source=lib/snapshot.sh
source "$REPO_ROOT/devenv/lib/snapshot.sh"
# shellcheck source=lib/stack.sh
source "$REPO_ROOT/devenv/lib/stack.sh"
# shellcheck source=lib/github-app-auth.sh
source "$REPO_ROOT/devenv/lib/github-app-auth.sh"

trap 'lease_release_all; lock_release_all; snapshot_cleanup' EXIT

usage() {
  cat >&2 <<'EOF'
devenv — 工程基座唯一入口（命令面权威文档：devenv/COMMANDS.md）
用法：devenv [--json] <子命令> [参数]

工程栈（一切构建/启停/观察/执行的唯一入口；禁止直接操作 compose）：
  doctor                    一键体检（端点/引擎/矩阵/锁文件/worktree 身份与凭据状态/镜像/服务）；退出码=可开工与否
  prefetch                  预取镜像锁中的上游镜像（分阶段、有进度/超时、可中断续跑；机器级拉取锁）
  build [--lockgen]         固定快照构建（tools + install + turbo build；幂等；--lockgen 强制重生成 lockfile）
  up                        启动 db/api 并等待真实健康终态（幂等）
  down [--volumes]          停止（--volumes 连带清数据卷）
  restart [svc...]          重启（默认全部）
  web [--port N] [--down]   启动前端并发布宿主端口（零端口不变量唯一例外；省略 --port 引擎自动分配空闲端口，实际端口见终值/status；与栈命令互斥）
  ps [-a]                   容器状态（含发布端口；--json 输出 JSONL）
  logs [svc] [-f] [--tail N] 跟随日志（透传原始流；--json 时原始流走 stderr，stdout 仅终值元数据）
  exec [svc] -- cmd...      在容器内执行（默认 tools；透传原始流；--json 同上包装）
  shell [svc]               交互 shell（默认 tools；透传原始流；--json 同 exec 包装）
  test [pattern...]         单元+集成测试（需先 up；连真实 PostGIS；运行期持共享栈租约）
  test:unit                 仅单元测试（零数据库基础设施；运行期持共享栈租约）
  lint / typecheck          ESLint / tsc --noEmit（运行期持共享栈租约）
  verify                    聚合质量门：lint + typecheck + test:unit（运行期持共享栈租约）
  migrate                   应用全部 pending 迁移到 dev 库（prisma migrate deploy）
  migrate:create --name N   生成空迁移待编辑（prisma migrate dev --create-only）
  seed                      幂等种子数据（运行期持共享栈租约）
  wait <svc> [--timeout N]  等待服务健康终态（默认 60s）
  status                    人读总览（容器+锁+租约+镜像）
  images [--verify]         查看镜像锁与生效 DB 镜像（含覆盖来源）/ 校验运行态 digest 漂移

GitHub App 认证入口（身份：GitHub App，非个人账号）：
  gh <args...>              以 App 身份执行 gh（拒绝 gh auth；拒绝 -R 指向未授权仓库）
  git-push <remote> <refspec...>
                            以 App 身份经 HTTPS 推送（只接受已配置 remote 名；目标必须授权）

测试：
  test:auth                 认证入口离线测试（不访问 GitHub）
  test:auth:integration     认证入口真实集成测试（默认只读；写操作需显式旗标）
  test:devenv               命令面离线测试（引擎解析/锁与栈使用租约/输出协议/快照与不可变绑定/per-worktree 隔离，mock docker）

退出码：0 成功 | 2 用法 | 3 环境未就绪 | 4 任务失败 | 5 超时 | 6 锁冲突 | 20–23 认证入口
EOF
}

# ---------------------------------------------------------------------------
# 工程栈子命令
# ---------------------------------------------------------------------------

cmd_doctor() {
  local failed=0 engine_ok=0
  local -a out=()
  chk() { # chk <name> <ok|warn|fail> <detail>
    out+=("{\"check\":\"$1\",\"result\":\"$2\",\"detail\":\"$(jstr "$3")\"}")
    [[ "$2" == fail ]] && failed=1
    (( JSON )) || printf '  [%s] %-18s %s\n' "$2" "$1" "$3" >&2
    return 0
  }
  (( JSON )) || note "doctor：环境体检"

  # 引擎端点/身份/版本/架构 + 矩阵（软收集：体检要报告全部检查项，不在首个失败处退出）
  if ! command -v docker >/dev/null 2>&1; then
    chk engine-endpoint fail "docker CLI 不在 PATH（白名单工具缺失）"
  elif ! engine_resolve; then
    chk engine-endpoint fail "$ENGINE_ERROR"
  elif ! engine_probe; then
    chk engine-endpoint fail "$ENGINE_ERROR"
  else
    engine_ok=1
    chk engine-endpoint ok "$ENGINE_IDENTITY $ENGINE_VERSION ($ENGINE_OS/$ENGINE_ARCH) @ $ENGINE_ENDPOINT（来源：$ENGINE_SOURCE）"
    engine_report
    if engine_check_matrix; then
      chk engine-matrix ok "引擎在支持矩阵内（$ENGINE_IDENTITY）"
    else
      chk engine-matrix fail "$ENGINE_ERROR"
    fi
  fi

  if (( engine_ok )) && docker compose version >/dev/null 2>&1; then
    chk compose-plugin ok "$(docker compose version --short 2>/dev/null || echo ok)"
  elif (( engine_ok )); then
    chk compose-plugin fail "compose v2 插件缺失"
  else
    chk compose-plugin fail "引擎不可用，无法校验 compose"
  fi

  if [[ -f "$IMAGES_LOCK" ]] && grep -q '^NODE_IMAGE=' "$IMAGES_LOCK" && grep -q '^DB_IMAGE=' "$IMAGES_LOCK"; then
    chk images-lock ok "$IMAGES_LOCK"
    # images_load 内含 die（锁格式/覆盖格式错误）——子shell 软化为体检项
    local db_info
    if db_info="$( (images_load && printf '%s（来源：%s）' "$DB_IMAGE_EFFECTIVE" "$DB_IMAGE_SOURCE") 2>&1 )"; then
      chk db-image ok "$db_info"
    else
      chk db-image fail "$db_info"
    fi
  else
    chk images-lock fail "devenv/images.lock 缺失或缺 NODE_IMAGE/DB_IMAGE 行"
    chk db-image fail "镜像锁不可用"
  fi

  # worktree 身份与 per-worktree 隔离状态（#59）：不触引擎，纯状态报告
  chk worktree ok "project=$PROJECT_NAME（suffix=$WT_SUFFIX；身份来源：$WT_IDENTITY_SOURCE）；本地镜像 tag 后缀 wt-$WT_SUFFIX；stack/migrate 锁 per-worktree、lockgen 机器级"
  local db_cred_f="${DEVENV_STATE_DIR:-$REPO_ROOT/.devenv-state}/db-credentials.env"
  if [[ -f "$db_cred_f" ]]; then
    chk db-credentials ok "每 worktree 随机口令已生成（$db_cred_f）"
  else
    chk db-credentials ok "未生成（任一 compose 调用命令——含只读 ps/logs/down——首次执行时生成每 worktree 随机口令并持久化）"
  fi

  # 镜像/服务为信息项（冷启动流程 clone → doctor → prefetch → build：doctor 时未构建不判失败）
  if (( engine_ok )); then
    if docker image inspect "$TOOLS_IMAGE" >/dev/null 2>&1; then
      chk tools-image ok "$TOOLS_IMAGE"
    else
      chk tools-image warn "未构建（冷启动正常；构建命令：devenv build）"
    fi
    if docker image inspect "$WS_IMAGE" >/dev/null 2>&1; then
      chk workspace-image ok "$WS_IMAGE"
    else
      chk workspace-image warn "未构建（冷启动正常；构建命令：devenv build）"
    fi
    # 快照状态（#58）：状态文件记录 快照 ↔ workspace/tools 不可变镜像标识（信息项）
    snapshot_state_load
    if [[ -z "$STATE_IMAGE_ID" && -z "$STATE_TOOLS_IMAGE_ID" ]]; then
      chk snapshot-state warn "无快照状态（冷启动正常；构建命令：devenv build）"
    else
      local ws_st="workspace 未构建" tools_st="tools 未构建"
      if [[ -n "$STATE_IMAGE_ID" ]] && docker image inspect "$STATE_IMAGE_ID" >/dev/null 2>&1; then
        ws_st="workspace ${STATE_IMAGE_ID:0:19}…"
      fi
      if [[ -n "$STATE_TOOLS_IMAGE_ID" ]] && docker image inspect "$STATE_TOOLS_IMAGE_ID" >/dev/null 2>&1; then
        tools_st="tools ${STATE_TOOLS_IMAGE_ID:0:19}…"
      fi
      chk snapshot-state ok "快照 ${STATE_SNAPSHOT_HASH:0:12}… ↔ $ws_st / $tools_st"
    fi
    local s
    for s in db api; do
      if svc_healthy "$s"; then chk "svc:$s" ok healthy;
      elif svc_running "$s"; then chk "svc:$s" warn "运行中但未健康";
      else chk "svc:$s" warn "未运行（启动命令：devenv up）"; fi
    done
    # #59 前共享项目 natural-enforcement 的遗留容器：不属于任何 worktree，
    # per-worktree down 不触碰；人工确认后清理，卷/镜像回收归 #75（宁多留勿误删）
    if docker ps -a --filter "label=com.docker.compose.project=natural-enforcement" --format '{{.Names}}' 2>/dev/null | grep -q .; then
      chk legacy-project warn "发现 #59 前共享项目 natural-enforcement 的遗留容器（不被任何 worktree 管理，不影响隔离语义）；修复：人工确认后 docker rm，资源回收归 #75"
    fi
  fi

  if (( JSON )); then
    local st="ok"; (( failed )) && st="failed"
    printf '{"command":"doctor","status":"%s","exitCode":%s,"checks":[%s]}\n' \
      "$st" "$(( failed ? 3 : 0 ))" "$(IFS=,; printf '%s' "${out[*]}")"
  else
    (( failed )) && note "体检未通过（见上）" || note "体检通过，可开工"
  fi
  exit "$(( failed ? 3 : 0 ))"
}

cmd_prefetch() {
  images_load
  # timeout 来自 coreutils（白名单）；macOS 为 gtimeout（brew coreutils）——两平台适配
  local timeout_bin
  timeout_bin="$(command -v timeout || command -v gtimeout || true)"
  [[ -n "$timeout_bin" ]] || die 3 "缺少 timeout/gtimeout（coreutils；macOS：brew install coreutils）"
  local timeout_s="${DEVENV_PREFETCH_TIMEOUT:-900}"
  # 机器级基础镜像拉取锁（#61）：跨 worktree 互斥；另一 worktree 正在 prefetch 时
  # 等待，超时 exit 6（重跑续跑）。栈使用租约只协调 per-worktree 栈，不加在此。
  lock_acquire prefetch 300
  local img rc
  for img in "$NODE_IMAGE" "$DB_IMAGE_EFFECTIVE"; do
    ev pull.started image="$img" timeout="$timeout_s"
    note "prefetch：拉取 $img（超时 ${timeout_s}s，可中断续跑——重复执行即可）"
    rc=0
    "$timeout_bin" "$timeout_s" docker pull "$img" >&2 || rc=$?
    if (( rc == 124 )); then
      final failed 5 image="$img" hint="拉取超时（${timeout_s}s）；重跑 devenv prefetch 续跑"
      die 5 "拉取超时：$img（${timeout_s}s）。重跑 devenv prefetch 断点续跑"
    elif (( rc != 0 )); then
      final failed 4 image="$img" hint="docker pull 退出码 $rc"
      die 4 "拉取失败：$img（docker pull 退出码 $rc）。检查网络后重跑 devenv prefetch"
    fi
    ev pull.completed image="$img"
  done
  note "prefetch 完成（2 个上游镜像就绪）"
  final ok 0 images="node,db"
}

cmd_build() {
  local lockgen=0
  [[ "${1:-}" == "--lockgen" ]] && lockgen=1
  lock_acquire "stack-$WT_SUFFIX" 120
  local t0=$(( $(date +%s) ))
  images_load

  # 固定输入快照（#58）：一次采集覆盖未提交修改/新增/删除及 Dockerfile、构建脚本、
  # 锁文件等构建输入；采集后构建只读快照（git 对象库），不再读取活工作树。
  local s dir
  s="$(snapshot_capture)"
  ev snapshot.captured hash="$s"

  # tools 基础镜像：同一快照链路核对/重建（NODE_IMAGE 取自快照内 images.lock）；
  # DB_IMAGE 是运行时输入（compose 注入），仍经 images_load 生效值 + 覆盖报告
  ensure_tools_image "$s"

  # 首次引导 / 显式 --lockgen：lockfile 经 lockgen 靶生成后 docker cp 导出（全程容器内，无 bind mount）
  snapshot_materialize_new "$s"
  dir="$SNAPSHOT_MATERIALIZED_DIR"
  if [[ ! -f "$dir/pnpm-lock.yaml" ]] || (( lockgen )); then
    note "lockgen：重生成 pnpm-lock.yaml（新增/变更 workspace 包后必须；生成后请随 git 提交并审查 diff）"
    regen_lockfile "$dir"
    # lockfile 已导出回工作树 → 重新采集快照再构建 workspace（构建输入必须含新 lockfile）；
    # 重新采集后基础镜像输入若变，必须重新核对（评审要求）
    s="$(snapshot_capture)"
    ev snapshot.captured hash="$s" reason="lockgen"
    snapshot_discard "$dir"
    ensure_tools_image "$s"
  fi
  snapshot_discard "$dir"

  build_workspace_from_snapshot "$s"

  note "build 完成"
  final ok 0 duration="$(( $(date +%s) - t0 ))s" snapshot="$s"
}

regen_lockfile() { # $1=快照物化目录；lockgen 靶生成 lockfile 后 docker cp 导出（--lockfile-only 不拉包）
  local dir="$1" target="lockgen"
  ev step.started target="lockgen"
  # lockgen 用机器级共享资源（ne-lockgen:tmp 标签 + 同名遗留容器清理），跨 worktree
  # 互斥（#59：stack/migrate 锁 per-worktree，lockgen 机器级）；持锁期间其它 worktree
  # 的 build 触发 lockgen 会等待或 exit 6（重跑即续）
  lock_acquire lockgen 300
  # 前置清理：上次异常退出可能留下持锁容器（image in use → rmi 失败连锁，原型实测坑）
  # （不用 xargs -r：macOS 宿主 xargs 无 -r）
  local stale_cids
  stale_cids="$(docker ps -a --filter ancestor=ne-lockgen:tmp -q)"
  # shellcheck disable=SC2086
  [[ -n "$stale_cids" ]] && docker rm -f $stale_cids >/dev/null 2>&1 || true
  docker rmi -f ne-lockgen:tmp >/dev/null 2>&1 || true
  # 首引导（快照内无 lockfile）走 lockgen-fresh 全量解析；有 lockfile 走增量解析（#54 §六.2）
  [[ -f "$dir/pnpm-lock.yaml" ]] || target="lockgen-fresh"
  # 基础镜像经 build-arg 绑定本次 tools 不可变 ID（不依赖 per-worktree 可变标签 wt-<suffix>）
  run_step "lockgen 镜像构建" \
    docker build -q -f "$dir/devenv/workspace.Dockerfile" --target "$target" -t ne-lockgen:tmp \
      --build-arg "TOOLS_IMAGE=$TOOLS_IMAGE_EFFECTIVE" "$dir"
  local cid
  cid="$(docker create ne-lockgen:tmp)"
  run_step "lockfile 导出" docker cp "$cid":/workspace/pnpm-lock.yaml "$REPO_ROOT/pnpm-lock.yaml"
  docker rm "$cid" >/dev/null; docker rmi ne-lockgen:tmp >/dev/null
  ev step.completed target="lockgen"
}

cmd_up() {
  lock_acquire "stack-$WT_SUFFIX" 60
  ensure_fresh_workspace
  # 顺序：db 健康 → 迁移幂等应用（fresh clone 的 SPEC 冷启动流无独立 migrate 步，
  # up 必须交付"真实健康终态"= 可用 schema）→ api 启动（不服务于无 schema 窗口期）
  run_step "db 启动" compose up -d db
  ev wait.started service="db"
  wait_healthy db 180
  ev wait.ok service="db"
  ev step.started target="migrate deploy"
  run_step "迁移应用（prisma migrate deploy）" \
    in_tools pnpm --filter @ne/api exec prisma migrate deploy
  ev step.completed target="migrate deploy"
  run_step "api 启动" compose up -d api
  ev wait.started service="api"
  wait_healthy api 120
  ev wait.ok service="api"
  verify_svc_image api  # 启动核对：运行容器 == 本次构建的不可变镜像标识（#58）
  note "全部服务健康（db, api），迁移已应用"
  final ok 0 services="db,api"
}

cmd_down() {
  lock_acquire "stack-$WT_SUFFIX" 60
  local args=(--remove-orphans) vol=kept
  # --remove-orphans：清掉已不在 compose 文件中的本项目容器（如原型遗留的 redis/rustfs）；
  # 仅本 worktree 项目范围（-p per-worktree）——#59 前共享项目 natural-enforcement 的
  # 遗留资源不在此列（doctor 会 warn；回收归 #75）
  [[ "${1:-}" == "--volumes" ]] && args+=(-v) && vol=removed
  run_step "栈停止" compose down "${args[@]}"
  final ok 0 volumes="$vol"
}

cmd_restart() {
  lock_acquire "stack-$WT_SUFFIX" 60
  run_step "栈重启" compose restart "$@"
  final ok 0 services="${*:-all}"
}

cmd_ps() {
  local -a ps_args=()
  [[ -n "${ALL:-}" ]] && ps_args+=(-a)
  ps_args+=(--filter "label=com.docker.compose.project=$PROJECT_NAME")
  if (( JSON )); then
    docker ps "${ps_args[@]}" --format '{{json .}}'
  else
    docker ps "${ps_args[@]}" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
  fi
}

cmd_logs() { run_passthrough compose logs "$@"; }  # 透传命令：子进程原始流（--json 包装终值元数据）

cmd_exec() {
  local svc="tools"
  if [[ "${1:-}" != "--" && "${1:-}" != "" && "${1:-}" != -* ]]; then svc="$1"; shift; fi
  [[ "${1:-}" == "--" ]] && shift
  [[ $# -gt 0 ]] || die 2 "exec 需要命令：devenv exec [svc] -- cmd..."
  if [[ "$svc" == "tools" ]]; then
    run_passthrough in_tools "$@"
  else
    svc_running "$svc" || die 3 "服务 [$svc] 未运行。修复命令：devenv up"
    run_passthrough compose exec "$svc" "$@"
  fi
}

cmd_shell() {
  local svc="${1:-tools}"
  if [[ "$svc" == "tools" ]]; then
    run_passthrough in_tools bash
  else
    svc_running "$svc" || die 3 "服务 [$svc] 未运行。修复命令：devenv up"
    run_passthrough compose exec "$svc" bash
  fi
}

run_task() { # $@ = 容器内命令；任务失败 → 退出码 4（终值 exitCode=4，子进程码入 taskRc）
  # 防御 #56 起潜伏的真 bug：宿主函数名（run_gate）曾被直接传进容器执行。
  # 容器内没有宿主 bash 函数——这类调用在本机响亮失败，而不是离线 mock 下被吞。
  if declare -F "${1:-}" >/dev/null 2>&1; then
    die 2 "内部错误：run_task 只接受容器内可执行命令，收到宿主函数名：$1（质量门请经 run_gate_task 调用）"
  fi
  # 子进程原始输出分流到 stderr（--json 时 stdout 只放结果流，Spec §4 输出协议）
  local rc=0
  in_tools "$@" >&2 || rc=$?
  if (( rc )); then
    final failed 4 taskRc="$rc" hint="任务命令退出码 $rc（完整输出见上方 stderr）"
    exit 4
  fi
}

# 质量门执行：run_gate 是宿主函数（内部自行 in_tools），直接调用——失败映射
# exit 4，与 run_task 同口径（防漂移：lint/typecheck/test:unit 与 verify 共用 run_gate）
run_gate_task() {
  local gate="$1" rc=0
  run_gate "$gate" || rc=$?
  if (( rc )); then
    final failed 4 taskRc="$rc" hint="质量门 $gate 退出码 $rc（完整输出见上方 stderr）"
    exit 4
  fi
}

# 质量门单一事实源（cmd_lint/cmd_typecheck/cmd_test_unit 与 cmd_verify 共用，防漂移）
run_gate() {
  case "$1" in
    lint)      in_tools pnpm -w exec eslint . >&2 ;;
    typecheck) in_tools pnpm -r run typecheck >&2 ;;
    test:unit) in_tools pnpm -r run test:unit >&2 ;;
    *) die 2 "未知质量门：$1（可选：lint|typecheck|test:unit）" ;;
  esac
}

cmd_test() {
  lease_acquire "stack-$WT_SUFFIX" 120  # 栈使用租约（#61）：测试运行期与拆栈/迁移/重启互斥
  ensure_fresh_workspace
  require_services db
  if (( $# )); then
    run_task pnpm --filter @ne/api exec vitest run "$@"
  else
    # 运行期不走 turbo（podman 场景 turbo 缓存/日志写入有 EACCES 前科，原型 NOTES）；
    # turbo 只用于镜像构建期。pnpm -r --no-bail = 全收集后汇总失败。
    run_task pnpm -r --no-bail run test
  fi
  final ok 0 scope=all
}

cmd_test_unit() { lease_acquire "stack-$WT_SUFFIX" 120; ensure_fresh_workspace; run_gate_task test:unit; final ok 0 scope=unit; }
cmd_lint()      { lease_acquire "stack-$WT_SUFFIX" 120; ensure_fresh_workspace; run_gate_task lint; final ok 0; }
cmd_typecheck() { lease_acquire "stack-$WT_SUFFIX" 120; ensure_fresh_workspace; run_gate_task typecheck; final ok 0; }

# verify：聚合确定性质量门（Spec §6：lint + typecheck + test:unit；e2e 生命周期校验归
# Spec-e2e 体系，本票不含）。本地与 CI 同一入口同一校验器。各门独立收集结果，
# 任一失败 → 退出码 4。
cmd_verify() {
  lease_acquire "stack-$WT_SUFFIX" 120  # 栈使用租约（#61）：质量门运行期与拆栈/迁移互斥
  ensure_fresh_workspace
  # 不用关联数组（macOS 宿主 bash 3.2 不支持）——逐门记录
  local r_lint="" r_typecheck="" r_unit=""
  local g rc res failed=0
  for g in lint typecheck test:unit; do
    ev gate.started gate="$g"
    rc=0
    run_gate "$g" || rc=$?
    if (( rc )); then failed=1; res="fail($rc)"; else res="ok"; fi
    case "$g" in
      lint) r_lint="$res" ;; typecheck) r_typecheck="$res" ;; test:unit) r_unit="$res" ;;
    esac
    ev gate.completed gate="$g" result="$res"
  done
  if (( failed )); then
    final failed 4 lint="$r_lint" typecheck="$r_typecheck" test_unit="$r_unit"
    die 4 "verify 未通过：lint=$r_lint typecheck=$r_typecheck test:unit=$r_unit"
  fi
  note "verify 全绿（lint + typecheck + test:unit）"
  final ok 0 lint=ok typecheck=ok test_unit=ok
}

cmd_migrate() {
  lock_acquire "stack-$WT_SUFFIX" 10
  lock_acquire "migrate-$WT_SUFFIX" 10
  ensure_fresh_workspace
  require_services db
  run_task pnpm --filter @ne/api exec prisma migrate deploy
  final ok 0 mode=deploy
}

cmd_migrate_create() {
  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="${2:?--name 需要值}"; shift 2;;
      *) die 2 "未知参数：$1（用法：migrate:create --name <snake_case 名>）";;
    esac
  done
  [[ -n "$name" ]] || die 2 "缺 --name"
  lock_acquire "stack-$WT_SUFFIX" 10
  lock_acquire "migrate-$WT_SUFFIX" 10
  ensure_fresh_workspace
  require_services db
  # 无 bind 架构：迁移文件生成在容器内——用留名容器 + docker cp 导出（--rm 会丢文件）；
  # 镜像内容物为 root 属主，故以 root 身份运行写入；容器名 per-worktree（机器级唯一）
  local cname="ne-migrate-create-$WT_SUFFIX"
  docker rm -f "$cname" >/dev/null 2>&1 || true
  compose run --name "$cname" -u 0:0 tools \
    pnpm --filter @ne/api exec prisma migrate dev --create-only --name "$name" >&2
  # 容器已退出：docker cp 支持停止态容器——整目录导出后合并
  mkdir -p "$REPO_ROOT/apps/api/prisma/migrations"
  rm -rf "$REPO_ROOT/apps/api/prisma/.migrations-imp"
  docker cp "$cname:/workspace/apps/api/prisma/migrations" "$REPO_ROOT/apps/api/prisma/.migrations-imp" >&2
  mv "$REPO_ROOT/apps/api/prisma/.migrations-imp"/* "$REPO_ROOT/apps/api/prisma/migrations/" >&2
  rmdir "$REPO_ROOT/apps/api/prisma/.migrations-imp" 2>/dev/null || true
  docker rm "$cname" >/dev/null
  local newest
  # 只取时间戳目录（migration_lock.toml 按字母序排在目录之后，须排除——评审实测）
  newest="$(ls -1 "$REPO_ROOT/apps/api/prisma/migrations" | grep -v '^migration_lock\.toml$' | tail -1)"
  note "空迁移已导出到 apps/api/prisma/migrations/$newest——编辑 migration.sql（PostGIS 手写段用 -- AddPostGIS: 注释头）后执行 devenv migrate"
  final ok 0 name="$name" dir="$newest"
}

cmd_seed() {
  lease_acquire "stack-$WT_SUFFIX" 120  # 栈使用租约（#61）：种子运行期与拆栈/迁移互斥
  ensure_fresh_workspace
  require_services db
  run_task pnpm --filter @ne/api run seed
  final ok 0
}

# 前端入口：人类/agent 显式 opt-in 发布宿主端口（零宿主端口不变量的唯一例外——
# 浏览器在宿主机）。无 bind 架构下无 HMR：改动反馈环 = 重新执行 devenv web
# （层缓存秒级重建）→ 浏览器刷新。
# 并发端口分配（#62，Spec「并发端口分配」）：省略 --port 时注入裸容器端口，引擎在
# 绑定时原子分配空闲宿主端口（两进程并发 web 实际成功、天然不同端口；判据是绑定
# 结果，不是探测时空闲）；实际端口经 docker port 回读，进 --json 终值与 status。
# 需要固定地址（人读书签等）时显式 --port N——冲突在引擎绑定时真实失败后诊断占用者。
cmd_web() {
  local port="" down=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="${2:?--port 需要值}"; shift 2;;
      --down) down=1; shift;;
      *) die 2 "未知参数：$1（用法：web [--port N] [--down]）";;
    esac
  done
  if [[ -n "$port" ]]; then
    [[ "$port" =~ ^[0-9]+$ ]] && (( 10#$port >= 1 && 10#$port <= 65535 )) \
      || die 2 "--port 需要 1-65535 的数字：$port"
  fi
  if (( down )); then
    lock_acquire "stack-$WT_SUFFIX" 60  # web --down 也是栈变更（#61：复合过程整体持锁）
    compose --profile web rm -sf web
    final ok 0 action=down
    return 0
  fi
  lock_acquire "stack-$WT_SUFFIX" 60  # web 做栈变更（构建+启动），与 down/restart 等互斥（COMMANDS.md 锁表）
  ensure_fresh_workspace
  # 省略 --port → 裸容器端口（引擎运行时分配）；显式 --port → 固定发布
  local spec="4173"
  [[ -n "$port" ]] && spec="$port:4173"
  local rc=0
  WEB_PORT_SPEC="$spec" compose --profile web up -d web >&2 || rc=$?
  if (( rc )); then
    web_bind_failure_diagnose "$port"  # 确认端口占用 → die 3（含占用者与内嵌修复命令）
    final failed 4 step="web 启动" taskRc="$rc"
    die 4 "web 启动失败（compose 退出码 $rc，完整输出见上方 stderr）"
  fi
  wait_healthy web 120
  verify_svc_image web  # 启动核对：运行容器 == 本次构建的不可变镜像标识（#58）
  local actual
  actual="$(web_actual_port)"
  [[ -n "$actual" ]] || { final failed 4 step="web 端口回读"; die 4 "web 已健康但无法回读实际宿主端口（docker port 为空）。排查：devenv ps；devenv logs web"; }
  note "web 就绪：http://localhost:$actual（地图瓦片由浏览器自行拉取 OSM）"
  final ok 0 url="http://localhost:$actual" port="$actual"
}

cmd_wait() {
  local svc="${1:?用法：wait <db|api|web> [--timeout N]}"; shift || true
  local timeout=60
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) timeout="${2:?}"; shift 2;;
      *) die 2 "未知参数：$1";;
    esac
  done
  case "$svc" in db|api|web) ;; *) die 2 "未知服务：$svc（可选：db|api|web）";; esac
  wait_healthy "$svc" "$timeout"
  final ok 0 service="$svc"
}

cmd_status() {
  if (( JSON )); then
    # 结构化总览：容器 JSONL + 终值（worktree 身份+锁+镜像生效值+快照状态），不静默退化成 ps
    docker ps --filter "label=com.docker.compose.project=$PROJECT_NAME" --format '{{json .}}'
    images_load
    snapshot_state_load
    # 凭据只读报告（status 不生成状态）：存在=stored，否则 none（首次 compose 调用生成）
    local cred_origin="none"
    [[ -f "${DEVENV_STATE_DIR:-$REPO_ROOT/.devenv-state}/db-credentials.env" ]] && cred_origin="stored"
    # 租约只读报告（#61）：stale 仅标注，不清理（status 是只读命令）
    local leases="none"
    leases="$(lease_report_all | tr '\n' ';' | sed 's/;$//')"
    [[ -n "$leases" ]] || leases="none"
    # web 实际宿主端口（#62）：按本 worktree 项目标签回读运行容器；未运行如实报 none
    local web_port web_url="none"
    web_port="$(web_actual_port)"
    [[ -n "$web_port" ]] && web_url="http://localhost:$web_port" || web_port="none"
    final ok 0 project="$PROJECT_NAME" worktree_suffix="$WT_SUFFIX" worktree_source="$WT_IDENTITY_SOURCE" \
      db_credentials="$cred_origin" \
      locks="$(ls -1 "$LOCK_ROOT" 2>/dev/null | grep '\.lock$' | paste -sd, - || true)" \
      leases="$leases" \
      web_port="$web_port" web_url="$web_url" \
      node_image="$NODE_IMAGE" db_image="$DB_IMAGE_EFFECTIVE" db_image_source="$DB_IMAGE_SOURCE" \
      snapshot_hash="${STATE_SNAPSHOT_HASH:-none}" workspace_image_id="${STATE_IMAGE_ID:-none}" \
      tools_image_id="${STATE_TOOLS_IMAGE_ID:-none}"
    return 0
  fi
  note "worktree：project=$PROJECT_NAME（suffix=$WT_SUFFIX；身份来源：$WT_IDENTITY_SOURCE）"
  note "容器（本项目）："
  cmd_ps
  # web 实际宿主端口（#62）：按本 worktree 项目标签回读；per-worktree 可查询
  local web_port
  web_port="$(web_actual_port)"
  if [[ -n "$web_port" ]]; then
    note "web：http://localhost:$web_port（宿主 $web_port → 容器 4173；零宿主端口唯一例外）"
  else
    note "web：未运行（启动：devenv web——省略 --port 时引擎自动分配空闲端口）"
  fi
  note "锁（$LOCK_ROOT，机器级命名空间；本 worktree 锁名 stack-$WT_SUFFIX / migrate-$WT_SUFFIX，机器级 lockgen/prefetch）："
  ls -1 "$LOCK_ROOT" 2>/dev/null | grep '\.lock$' | sed 's/^/  /' >&2 || true
  note "栈使用租约（#61；active=持有进程存活，stale=已死待下次取得清理）："
  local lease_lines=""
  lease_lines="$(lease_report_all)"
  if [[ -n "$lease_lines" ]]; then
    printf '%s\n' "$lease_lines" | sed 's/^/  /' >&2
  else
    printf '  无\n' >&2
  fi
  images_load
  snapshot_state_load
  note "镜像：node=$NODE_IMAGE"
  note "镜像：db=$DB_IMAGE_EFFECTIVE（来源：$DB_IMAGE_SOURCE）"
  note "镜像 tag：tools=$TOOLS_IMAGE workspace=$WS_IMAGE（per-worktree；运行绑定不可变 ID）"
  note "快照：${STATE_SNAPSHOT_HASH:-无}"
  note "绑定：workspace=${STATE_IMAGE_ID:-无} tools=${STATE_TOOLS_IMAGE_ID:-无}"
}

cmd_images() {
  images_load
  if [[ "${1:-}" == "--verify" ]]; then
    # 校验运行中容器镜像 digest 与生效锁一致：经容器→image RepoDigests 取 manifest sha
    local lock_sha run_sha cid img digest rc=0
    lock_sha="${DB_IMAGE_EFFECTIVE##*@}"
    if [[ "$lock_sha" == "$DB_IMAGE_EFFECTIVE" ]]; then
      # 生效引用无 digest（覆盖为裸 tag）：无法做 digest 级校验，如实报告
      (( JSON )) && printf '{"service":"db","result":"no-digest-in-ref","ref":"%s"}\n' "$(jstr "$DB_IMAGE_EFFECTIVE")" \
        || warn "db 生效引用无 digest（$DB_IMAGE_EFFECTIVE），无法 digest 级校验"
      exit 1
    fi
    cid="$(docker ps --filter "label=com.docker.compose.project=$PROJECT_NAME" \
      --filter "label=com.docker.compose.service=db" --format '{{.ID}}' | head -1)"
    if [[ -z "$cid" ]]; then
      (( JSON )) && printf '{"service":"db","result":"not-running"}\n' || warn "db: 未运行"
      exit 1
    fi
    img="$(docker inspect "$cid" --format '{{.Image}}')"
    digest="$(docker image inspect "$img" --format '{{index .RepoDigests 0}}')"
    run_sha="${digest##*@}"
    if [[ "$run_sha" == "$lock_sha" ]]; then
      (( JSON )) && printf '{"service":"db","result":"ok","digest":"%s"}\n' "$run_sha" || note "db: ok ($run_sha)"
    else
      (( JSON )) && printf '{"service":"db","result":"drift","locked":"%s","running":"%s"}\n' "$lock_sha" "$run_sha" \
        || warn "db: 漂移（锁=$lock_sha，运行=$run_sha）。修复：devenv down && devenv up"
      rc=1
    fi
    exit "$rc"
  fi
  # 人读/机读双用：非 --json 猫锁文件原文 + 生效值；--json 只放结构化结果（不混原文进结果流）
  if (( JSON )); then
    printf '{"node_image":"%s","db_image":"%s","source":"%s"}\n' \
      "$(jstr "$NODE_IMAGE")" "$(jstr "$DB_IMAGE_EFFECTIVE")" "$(jstr "$DB_IMAGE_SOURCE")"
  else
    cat "$IMAGES_LOCK"
    note "生效 DB 镜像：$DB_IMAGE_EFFECTIVE（来源：$DB_IMAGE_SOURCE）"
  fi
}

# ---------------------------------------------------------------------------
# 入口
# ---------------------------------------------------------------------------
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON=1; shift;;
    -h|--help) usage; exit 0;;
    *) CMD="$1"; shift; break;;
  esac
done
[[ -n "$CMD" ]] || { usage; exit 2; }

case "$CMD" in
  # GitHub App 认证入口（不触引擎，保持既有行为与退出码 20–23）
  gh)                     gha_cmd_gh "$@" ;;
  git-push)               gha_cmd_git_push "$@" ;;
  test:auth)              bash "$REPO_ROOT/devenv/test/offline.test.sh" ;;
  test:auth:integration)  bash "$REPO_ROOT/devenv/test/integration.test.sh" "$@" ;;
  test:devenv)            bash "$REPO_ROOT/devenv/test/stack-offline.test.sh" && bash "$REPO_ROOT/devenv/test/snapshot-offline.test.sh" && bash "$REPO_ROOT/devenv/test/isolation-offline.test.sh" ;;
  help)                   usage; exit 0 ;;
  # doctor 自带软引擎检查（体检报告全部检查项，不在首个失败处退出）
  doctor)                 cmd_doctor "$@" ;;
  # 工程栈命令：先解析/校验/报告引擎端点（Spec：每条命令报告实际端点+引擎身份）
  prefetch|build|up|down|restart|ps|logs|exec|shell|test|test:unit|lint|typecheck|verify|migrate|migrate:create|seed|wait|status|images|web)
    engine_init
    case "$CMD" in
      prefetch)       cmd_prefetch "$@";;
      build)          cmd_build "$@";;
      up)             cmd_up "$@";;
      down)           cmd_down "$@";;
      restart)        cmd_restart "$@";;
      ps)             [[ "${1:-}" == "-a" || "${1:-}" == "--all" ]] && ALL=1 && shift; cmd_ps "$@";;
      logs)           cmd_logs "$@";;
      exec)           cmd_exec "$@";;
      shell)          cmd_shell "$@";;
      test)           cmd_test "$@";;
      test:unit)      cmd_test_unit "$@";;
      lint)           cmd_lint "$@";;
      typecheck)      cmd_typecheck "$@";;
      verify)         cmd_verify "$@";;
      migrate)        cmd_migrate "$@";;
      migrate:create) cmd_migrate_create "$@";;
      seed)           cmd_seed "$@";;
      wait)           cmd_wait "$@";;
      status)         cmd_status "$@";;
      images)         cmd_images "$@";;
      web)            cmd_web "$@";;
    esac
    ;;
  *)
    usage; die 2 "未知子命令：$CMD";;
esac
