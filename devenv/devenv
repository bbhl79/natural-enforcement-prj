      seed)           cmd_seed "$@";;
      wait)           cmd_wait "$@";;
      status)         cmd_status "$@";;
      images)         cmd_images "$@";;
      web)            cmd_web "$@";;
      gen)            cmd_gen "$@";;
      e2e)            cmd_e2e "$@";;
