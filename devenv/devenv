#!/usr/bin/env bash
# ============================================================================
# PROTOTYPE（一次性原型，非生产代码）— 工程基座纵切一：环境与后端（issue #11）
#
# devenv：唯一环境入口。宿主机依赖白名单内只有 bash + docker(含 compose 插件)。
# 一切 node/pnpm/turbo/prisma 执行都在容器内完成；本脚本只做编排与输出整形。
#
# 机器可解析输出：全局旗标 --json（短命令=stdout 单 JSON；长命令=JSONL 事件流，
# 终值事件 {"event":"completed"}）。人类可读进度一律走 stderr，stdout 保持可管道。
#
# 退出码枚举：
#   0 成功
#   2 用法错误（未知子命令/缺参数）
#   3 环境未就绪（镜像未构建/容器未起/依赖未装——按提示先跑对应命令）
#   4 任务失败（test/lint/typecheck/build 等任务自身非零退出；探索轨道"发现失败"亦属此类）
#   5 超时（wait/健康等待超时）
#   6 独占锁冲突（另一 agent 正在执行互斥操作）
#   ── e2e 生命周期（#13；码表与 apps/e2e/src/cli.ts 联合定型）──
#   7 生命周期校验失败（verify 防降级校验器）
#   8 状态转移/前置条件不合法（report 门禁未过/graduate 重复或非法转移等）
#   9 毕业校验运行判定不符（未修必须失败/已修必须通过——翻译质量把关）
#   10 缺陷不存在或 schema 不符
# ============================================================================
set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEVENV_DIR="$REPO_ROOT/devenv"
PROJECT_NAME="natural-enforcement"
TOOLS_IMAGE="natural-enforcement/tools:prototype1"
WS_IMAGE="natural-enforcement/workspace:local"   # 代码烘焙镜像（无 bind mount 架构，见 devenv/workspace.Dockerfile）
IMAGES_LOCK="$DEVENV_DIR/images.lock"
COMPOSE_FILE="$DEVENV_DIR/compose.yaml"
E2E_IMAGE="natural-enforcement/e2e:local"          # e2e 执行器（官方 Playwright 镜像 + 项目运行时，#13）
E2E_DOCKERFILE="$DEVENV_DIR/e2e.Dockerfile"
E2E_CUR_RUN_ID=""                                   # 当前隔离栈 run_id（verify-run 注入用）
LOCK_DIR="/tmp/natural-enforcement-locks"   # 机器级锁（跨 worktree/跨 agent 共享）
JSON=0

# ---------------------------------------------------------------------------
# 输出助手：进度走 stderr；--json 时 stdout 只放 JSON/JSONL
# ---------------------------------------------------------------------------
note() { printf '[devenv] %s\n' "$*" >&2; }
warn() { printf '[devenv] WARN: %s\n' "$*" >&2; }
die()  { local code="$1"; shift; printf '[devenv] ERROR: %s\n' "$*" >&2; exit "$code"; }

jstr() { # JSON 字符串转义（覆盖常见控制字符，足够原型用）
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"; s="${s//$'\t'/\\t}"; s="${s//$'\r'/\\r}"
  printf '%s' "$s"
}
ev() { # 事件（--json 时输出 JSONL）：ev <name> [k=v]...
  (( JSON )) || return 0
  local name="$1"; shift
  local pairs="" k v
  for kv in "$@"; do
    k="${kv%%=*}"; v="${kv#*=}"
    pairs+=",\"$k\":\"$(jstr "$v")\""
  done
  printf '{"event":"%s"%s}\n' "$name" "$pairs"
}
final() { # 终值（--json 时输出单 JSON；非 json 不输出）：final <status> <exitCode> [k=v...]
  local status="$1" exit_code="$2"; shift 2
  (( JSON )) || return 0
  local pairs="" kv k v
  for kv in "$@"; do
    k="${kv%%=*}"; v="${kv#*=}"
    pairs+=",\"$k\":\"$(jstr "$v")\""
  done
  printf '{"command":"%s","status":"%s","exitCode":%s%s}\n' "$CMD" "$status" "$exit_code" "$pairs"
}

# ---------------------------------------------------------------------------
# 基础设施
# ---------------------------------------------------------------------------
require_lock_file() {
  [[ -f "$IMAGES_LOCK" ]] || die 3 "镜像锁文件缺失：$IMAGES_LOCK（devenv/images.lock 是版本唯一事实源）"
}
compose() {
  require_lock_file
  # 镜像引用（tag+digest）从锁文件注入 compose 变量插值
  set -a; # shellcheck disable=SC1090
  . "$IMAGES_LOCK"; set +a
  REPO_ROOT="$REPO_ROOT" WORKSPACE_IMAGE="$WS_IMAGE" E2E_IMAGE="$E2E_IMAGE" DOCKER_UID="$(id -u)" DOCKER_GID="$(id -g)" \
    WEB_PORT="${WEB_PORT:-5173}" \
    docker compose -p "$PROJECT_NAME" -f "$COMPOSE_FILE" "$@"
}
in_tools() { # 在工具容器内执行（每次临时容器，退出即回收）
  compose run --rm tools "$@"
}

# 无 bind 架构：代码烘焙进镜像。凡消费当前源码的命令（up/test/lint/typecheck/migrate*/seed）
# 先增量重建 workspace 镜像（层缓存命中时秒级），保证容器内即最新代码。
ensure_fresh_workspace() {
  ev step.started target="workspace image refresh"
  docker build -q -t "$WS_IMAGE" -f "$DEVENV_DIR/workspace.Dockerfile" "$REPO_ROOT" >&2
  ev step.completed target="workspace image refresh"
}

# ---------------------------------------------------------------------------
# e2e 双轨编排（#13）：数据级隔离（共享基础设施容器 + 独立库/bucket/键空间）。
# 隔离参数只在此层注入——测试代码只感知 baseURL（playwright-e2e.md §2.3 层 1）。
# ---------------------------------------------------------------------------
new_run_id() { printf '%s%s%s' "$1" "$(date +%s)" "$RANDOM"; }   # [a-z0-9]+，PG 库名/bucket 名安全

ensure_fresh_e2e_image() { # e2e 执行器镜像（官方 Playwright 基座，tag+digest 锁注入）
  ev step.started target="e2e image refresh"
  set -a; # shellcheck disable=SC1090
  . "$IMAGES_LOCK"; set +a
  docker build -q --build-arg PLAYWRIGHT_IMAGE="$PLAYWRIGHT_IMAGE" \
    -t "$E2E_IMAGE" -f "$E2E_DOCKERFILE" "$REPO_ROOT" >&2
  ev step.completed target="e2e image refresh"
}

e2e_registry_lock() { # 生命周期写入互斥（per-worktree；跨 worktree 各自独立不误伤）
  acquire_lock "e2e-$(printf '%s' "$REPO_ROOT" | md5sum | cut -c1-8)" "${1:-600}"
}

e2e_ensure_infra() { # 共享基础设施容器（dev 栈同款；幂等）
  compose up -d db redis rustfs >&2
  local s
  for s in db redis rustfs; do wait_healthy "$s" 120; done
}

e2e_stack_up() { # $1=run_id $2=with_web(1/0)：建库→迁移→起 e2e-api(+e2e-web)→等健康
  local rid="$1" with_web="${2:-1}"
  ensure_fresh_workspace
  ensure_fresh_e2e_image
  e2e_ensure_infra
  # 干净库（幂等重入）：FORCE DROP 断开活动连接再建（PG18）
  compose exec -T db psql -U ne -d natural_enforcement_dev \
    -c "DROP DATABASE IF EXISTS e2e_$rid WITH (FORCE)" -c "CREATE DATABASE e2e_$rid" >&2
  # 迁移到隔离库（migrations 是唯一版本真相；e2e 库走 deploy——prisma-postgis.md 决策）
  E2E_RUN_ID="$rid" compose run --rm -T \
    -e DATABASE_URL="postgresql://ne:ne-dev-only@db:5432/e2e_$rid" \
    tools pnpm --filter @ne/api exec prisma migrate deploy >&2
  local -a svcs=(e2e-api)
  (( with_web )) && svcs+=(e2e-web)
  E2E_RUN_ID="$rid" compose --profile e2e up -d "${svcs[@]}" >&2
  wait_healthy e2e-api 120
  (( with_web )) && wait_healthy e2e-web 120
  note "e2e 隔离栈就绪（run=$rid）：db=e2e_$rid bucket=e2e-$rid keyspace=e2e:$rid:"
}

e2e_teardown() { # $1=run_id：best-effort，失败不阻塞报告产出（层 1 纪律）
  local rid="$1"
  compose --profile e2e rm -sf e2e-api e2e-web e2e >/dev/null 2>&1 || true
  compose exec -T db psql -U ne -d natural_enforcement_dev \
    -c "DROP DATABASE IF EXISTS e2e_$rid WITH (FORCE)" >/dev/null 2>&1 || true
  compose run --rm -T tools node apps/e2e/dist/teardown-bucket.js "e2e-$rid" >/dev/null 2>&1 || true
  compose exec -T redis sh -c "redis-cli --scan --pattern '*e2e:$rid:*' | xargs -r redis-cli DEL" >/dev/null 2>&1 || true
  note "e2e 隔离栈已拆（run=$rid；库/桶/键空间清理 best-effort）"
}

e2e_export_artifacts() { # $1=run_id：产物命名卷 → 宿主 .artifacts/e2e/<run_id>/（docker cp，无 bind）
  local dest="$REPO_ROOT/.artifacts/e2e/$1" cid
  mkdir -p "$dest"
  cid="$(docker create --mount "type=volume,source=${PROJECT_NAME}_e2e-artifacts,target=/art" "$E2E_IMAGE" true)"
  docker cp "$cid":/art/. "$dest" >&2 || true
  docker rm "$cid" >/dev/null
  note "e2e 产物已导出：$dest"
}

e2e_run_playwright() { # $1=run_id $2=config(repro|explore)
  E2E_RUN_ID="$1" compose --profile e2e run --rm -T e2e \
    npx playwright test --config="apps/e2e/playwright.$2.config.ts"
}

e2e_replay_once() { # $1=run_id $2=command（缺陷记录的 replayCommand；退出 0=复现）
  E2E_RUN_ID="$1" compose --profile e2e run --rm -T e2e bash -c "$2" >/dev/null 2>&1
}

e2e_cli() { # 生命周期 CLI 桥（#13）：宿主树经 stdin tar 入容器（无 bind 读取通道）；
  # CLI 为纯决策引擎，stdout=op 行协议（W/D/V/END），stderr=人类可读。
  ensure_fresh_workspace
  local -a tar_args=(defects replay tests)
  [[ -f "$REPO_ROOT/apps/e2e/.registry.json" ]] && tar_args+=(".registry.json")
  (cd "$REPO_ROOT/apps/e2e" && tar -cf - "${tar_args[@]}") \
    | compose run --rm -T tools bash -c \
      'mkdir -p /tmp/in && tar -x -C /tmp/in && exec node /workspace/apps/e2e/dist/cli.js --root /tmp/in "$@"' _ "$@"
}

run_verify_payload() { # $1=defNNNN(数字段) $2=expect(fail|pass) $3=b64 → 0 判定相符 / 9 不符
  local vid="$1" expect="$2" b64="$3" rc=0
  svc_healthy e2e-api || die 3 "e2e-api 未就绪（毕业校验运行需要隔离栈；修复命令：重跑本命令）"
  local tmpd="$REPO_ROOT/apps/e2e/.verify-run"
  rm -rf "$tmpd"; mkdir -p "$tmpd"
  printf '%s' "$b64" | base64 -d > "$tmpd/def-$vid.verify.spec.ts"
  ev step.started target="graduate verify-run" defect="$vid" expect="$expect"
  (cd "$tmpd" && tar -cf - .) \
    | E2E_RUN_ID="${E2E_CUR_RUN_ID:-local}" compose --profile e2e run --rm -T e2e bash -c \
      'mkdir -p /workspace/apps/e2e/.verify-run && tar -x -C /workspace/apps/e2e/.verify-run && cd /workspace/apps/e2e && npx playwright test --config=playwright.verify.config.ts' || rc=$?
  rm -rf "$tmpd"
  if [[ "$expect" == "fail" ]]; then
    if (( rc != 0 )); then ev step.completed target="graduate verify-run" verdict="reproduced"; return 0; fi
    ev step.completed target="graduate verify-run" verdict="did-not-fail"; return 9
  fi
  if (( rc == 0 )); then ev step.completed target="graduate verify-run" verdict="passed"; return 0; fi
  ev step.completed target="graduate verify-run" verdict="still-failing"; return 9
}

apply_e2e_ops() { # $1=ops 文件：V 行先真跑校验（判定不符→9，零落盘）；END error→透传码；然后原子应用 W/D
  local opsfile="$1" end_status="ok" end_code=0 end_msg="" applied=0 vline vid vexpect vb64
  vline="$(grep -P '^V\t' "$opsfile" | head -1 || true)"
  if [[ -n "$vline" ]]; then
    IFS=$'\t' read -r _t vid vexpect vb64 <<<"$vline"
    if ! run_verify_payload "$vid" "$vexpect" "$vb64"; then
      printf '[devenv] ERROR: 毕业校验运行判定不符（expect=%s）——工作区零改动（全有或全无）\n' "$vexpect" >&2
      exit 9
    fi
  fi
  local endline
  endline="$(grep -P '^END\t' "$opsfile" | tail -1 || true)"
  if [[ -n "$endline" ]]; then
    IFS=$'\t' read -r _t end_status end_code end_msg <<<"$endline"
  fi
  if [[ "$end_status" != "ok" ]]; then
    printf '[devenv] ERROR: %s\n' "$end_msg" >&2
    exit "${end_code:-8}"
  fi
  local op f1 f2
  while IFS=$'\t' read -r op f1 f2 _rest; do
    case "$op" in
      W) mkdir -p "$(dirname "$REPO_ROOT/apps/e2e/$f1")"; printf '%s' "$f2" | base64 -d > "$REPO_ROOT/apps/e2e/$f1"; applied=$((applied+1));;
      D) rm -f "$REPO_ROOT/apps/e2e/$f1"; applied=$((applied+1));;
    esac
  done < <(grep -P '^[WD]\t' "$opsfile" || true)
  note "生命周期落账：$applied 项文件操作已应用到 apps/e2e/"
}

acquire_lock() { # $1=锁名 $2=超时秒；独占 flock（跨 worktree 生效）
  mkdir -p "$LOCK_DIR"
  exec 9>>"$LOCK_DIR/$1.lock"
  if ! flock -w "$2" 9; then
    die 6 "独占锁 [$1] 被占用（另一会话正在执行互斥操作），锁文件：$LOCK_DIR/$1.lock"
  fi
}

regen_lockfile() { # lockgen 靶生成 lockfile 后 docker cp 导出（全程容器内；--lockfile-only 不拉包）
  ev step.started target="lockgen"
  # 前置清理：上次异常退出可能留下持锁容器（image in use → rmi 失败 → 本命令连锁失败，#12 实测）
  docker ps -a --filter ancestor=ne-lockgen:tmp -q | xargs -r docker rm -f >/dev/null 2>&1 || true
  docker rmi -f ne-lockgen:tmp >/dev/null 2>&1 || true
  docker build -q -f "$DEVENV_DIR/workspace.Dockerfile" --target lockgen -t ne-lockgen:tmp "$REPO_ROOT" >&2
  local cid
  cid="$(docker create ne-lockgen:tmp)"
  docker cp "$cid":/workspace/pnpm-lock.yaml "$REPO_ROOT/pnpm-lock.yaml" >&2
  docker rm "$cid" >/dev/null; docker rmi ne-lockgen:tmp >/dev/null
  ev step.completed target="lockgen"
}

svc_running() { docker ps --filter "label=com.docker.compose.project=$PROJECT_NAME" \
    --filter "label=com.docker.compose.service=$1" --format '{{.Names}}' | grep -q .; }
svc_healthy() {
  # podman 兼容层的 docker ps Status 不带 "(healthy)" 后缀——以 inspect 的 Health.Status 为准
  local c
  c="$(docker ps -a --filter "label=com.docker.compose.project=$PROJECT_NAME" \
      --filter "label=com.docker.compose.service=$1" --format '{{.Names}}' | head -1)"
  [[ -n "$c" ]] && [[ "$(docker inspect "$c" --format '{{.State.Health.Status}}' 2>/dev/null)" == "healthy" ]]
}

require_services() { # 确保基础设施在跑；$@=服务名
  local s
  for s in "$@"; do
    svc_healthy "$s" || die 3 "服务 [$s] 未就绪。修复命令：devenv up"
  done
}

usage() {
  cat >&2 <<'EOF'
devenv — 环境唯一入口（PROTOTYPE #11）
用法：devenv [--json] <子命令> [参数]

命令面：
  build [--lockgen]         构建工具/workspace/e2e 三镜像 + 依赖 + turbo build（幂等；--lockgen 重生成 lockfile）
  up                        启动 db/redis/rustfs/api 并等待健康（幂等）
  web [--port N] [--down]   启动前端并发布宿主端口（#12；人类 opt-in，零端口不变量的唯一例外）
  gen <kind> <name>         脚手架生成（#12）：kind = app | package | nest-module | page
  down [--volumes]          停止（--volumes 连带清数据卷；不含 web，用 web --down）
  restart [svc...]          重启（默认全部）
  ps [-a]                   容器状态（--json 输出 JSONL）
  logs [svc] [-f] [--tail N] 跟随日志
  exec [svc] -- cmd...      在容器内执行（默认 tools；长驻服务用其名）
  shell [svc]               交互 shell（默认 tools）
  test [pattern...]         单元+集成测试（需先 up）[pattern 透传 vitest]
  test:unit                 仅单元测试（可缓存，无需基础设施）
  lint / typecheck          ESLint / tsc --noEmit
  migrate                   应用全部 pending 迁移到 dev 库（prisma migrate deploy）
  migrate:create --name N   生成空迁移待编辑（prisma migrate dev --create-only；独占）
  seed                      幂等种子数据（先构建后执行）
  wait <svc> [--timeout N]  等待服务健康（默认 60s）
  doctor                    一键体检；退出码即"可开工与否"
  status                    人读总览（容器+锁）
  images [--verify]         查看/校验镜像锁（tag+digest）
  ── e2e 双轨（#13）──────────────────────────────────────────────────────────
  ci [--run-id ID] [--full-down]  与 CI 同构：起隔离栈→只跑复现轨道→导产物→拆栈
  explore [--keep]          探索轨道（失败=产出：证据→缺陷报告；--keep 保留栈调试）
  verify [--diff-base REF]  质量门 + 生命周期防降级校验（CI 同一校验器）
  e2e report <ID>           登记缺陷：实测复现门禁（确定性 1 次/非确定 ≥3 次全复现）后落账
  e2e graduate <ID> [--fixed]     毕业事务：预检→转写→真跑校验→原子落账（不可机械转写→_drafts 草稿）
  e2e confirm-fix <ID>      修复确认：真跑通过→摘除 expected-fail→fixed
  e2e retire <ID> --reason "…" [--issue N]   退役：同事务删测试，记录永久留档
  e2e replay <ID> [--attempts N]  手动重放（诊断）
  e2e renumber              撞号/断号机械重排
  e2e defect list|show <ID> 缺陷查询（--json 输出 JSON）

退出码：0 成功 | 2 用法 | 3 环境未就绪 | 4 任务失败 | 5 超时 | 6 锁冲突
        | 7 生命周期校验失败 | 8 状态转移/前置条件不合法 | 9 毕业校验运行判定不符 | 10 缺陷不存在/schema
EOF
}

# ---------------------------------------------------------------------------
# 子命令
# ---------------------------------------------------------------------------
cmd_build() {
  local lockgen=0
  [[ "${1:-}" == "--lockgen" ]] && lockgen=1
  acquire_lock build 120
  local t0=$(( $(date +%s) ))
  ev step.started target="tools base image"
  # daemon 内建构建器直接构建（本机无 buildx；compose build 会试图拉 moby/buildkit 镜像）
  docker build -q -t "$TOOLS_IMAGE" -f "$DEVENV_DIR/tools.Dockerfile" "$REPO_ROOT" >&2
  ev step.completed target="tools base image"

  # 首次引导 / 显式 --lockgen：lockfile 经 lockgen 阶段生成后 docker cp 出来（全程容器内，无 bind mount）
  if [[ ! -f "$REPO_ROOT/pnpm-lock.yaml" ]] || (( lockgen )); then
    note "lockgen：重生成 pnpm-lock.yaml（新增/变更 workspace 包后必须；生成后请随 git 提交）"
    regen_lockfile
  fi

  ev step.started target="workspace image (install + turbo build)"
  docker build -q -t "$WS_IMAGE" -f "$DEVENV_DIR/workspace.Dockerfile" "$REPO_ROOT" >&2
  ev step.completed target="workspace image"

  ev step.started target="e2e image (playwright base + e2e runtime)"
  ensure_fresh_e2e_image
  ev step.completed target="e2e image"

  note "build 完成"
  final ok 0 duration="$(( $(date +%s) - t0 ))s"
}

cmd_up() {
  ensure_fresh_workspace
  compose up -d db redis rustfs api
  local s
  for s in db redis rustfs api; do
    ev wait.started service="$s"
    wait_healthy "$s" 90
    ev wait.ok service="$s"
  done
  note "全部服务健康"
  final ok 0 services="db,redis,rustfs,api"
}

cmd_down() {
  local args=()
  [[ "${1:-}" == "--volumes" ]] && args+=(-v)
  compose down "${args[@]}"
  final ok 0 volumes="${1:-kept}"
}

cmd_restart() {
  compose restart "$@"
  final ok 0 services="${*:-all}"
}

cmd_ps() {
  local -a ps_args=()
  [[ -n "${ALL:-}" ]] && ps_args+=(-a)
  ps_args+=(--filter "label=com.docker.compose.project=$PROJECT_NAME")
  if (( JSON )); then
    docker ps "${ps_args[@]}" --format '{{json .}}'
  else
    docker ps "${ps_args[@]}" --format 'table {{.Names}}\t{{.Status}}'
  fi
}

cmd_logs() { compose logs "$@"; }

cmd_exec() {
  local svc="tools"
  if [[ "${1:-}" != "--" && "${1:-}" != "" && "${1:-}" != -* ]]; then svc="$1"; shift; fi
  [[ "${1:-}" == "--" ]] && shift
  [[ $# -gt 0 ]] || die 2 "exec 需要命令：devenv exec [svc] -- cmd..."
  if [[ "$svc" == "tools" ]]; then
    in_tools "$@"
  else
    svc_running "$svc" || die 3 "服务 [$svc] 未运行。修复命令：devenv up"
    compose exec "$svc" "$@"
  fi
}

cmd_shell() {
  local svc="${1:-tools}"
  if [[ "$svc" == "tools" ]]; then
    in_tools bash
  else
    svc_running "$svc" || die 3 "服务 [$svc] 未运行。修复命令：devenv up"
    compose exec "$svc" bash
  fi
}

run_task() { # $@ = 容器内命令；任务失败 → 退出码 4
  local rc=0
  in_tools "$@" || rc=$?
  if (( rc )); then
    final failed "$rc" hint="任务命令退出码 $rc（完整输出见上方）"
    exit 4
  fi
}

cmd_test() {
  ensure_fresh_workspace
  require_services db redis rustfs
  if (( $# )); then
    run_task pnpm --filter @ne/api exec vitest run "$@"
  else
    # 运行期不走 turbo：podman-uid 场景下 turbo 缓存/日志写入 EACCES（坑记录 NOTES.md）；
    # turbo 只用于镜像构建期（那边环境可用）。pnpm -r --no-bail = 全收集后汇总失败。
    run_task pnpm -r --no-bail run test
  fi
  final ok 0 scope=all
}
cmd_test_unit() { ensure_fresh_workspace; run_task pnpm -r run test:unit; final ok 0 scope=unit; }
cmd_lint()      { ensure_fresh_workspace; run_task pnpm -w exec eslint .; final ok 0; }
cmd_typecheck() { ensure_fresh_workspace; run_task pnpm -r run typecheck; final ok 0; }

cmd_migrate() {
  acquire_lock migrate 10
  ensure_fresh_workspace
  require_services db
  run_task pnpm --filter @ne/api exec prisma migrate deploy
  final ok 0 mode=deploy
}

cmd_migrate_create() {
  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="${2:?--name 需要值}"; shift 2;;
      *) die 2 "未知参数：$1（用法：migrate:create --name <snake_case 名>）";;
    esac
  done
  [[ -n "$name" ]] || die 2 "缺 --name"
  acquire_lock migrate 10
  ensure_fresh_workspace
  require_services db
  # 无 bind 架构：迁移文件生成在容器内——用留名容器 + docker cp 导出（--rm 会丢文件）；
  # 镜像内容物为 root 属主（buildah 以 root 构建），故以 root 身份运行写入
  local cname="ne-migrate-create"
  docker rm -f "$cname" >/dev/null 2>&1 || true
  compose run --name "$cname" -u 0:0 tools \
    pnpm --filter @ne/api exec prisma migrate dev --create-only --name "$name" >&2
  # 容器已退出：docker cp 支持停止态容器——整目录导出后合并（镜像内原本无 migrations 目录）
  mkdir -p "$REPO_ROOT/apps/api/prisma/migrations"
  rm -rf "$REPO_ROOT/apps/api/prisma/.migrations-imp"
  docker cp "$cname:/workspace/apps/api/prisma/migrations" "$REPO_ROOT/apps/api/prisma/.migrations-imp" >&2
  mv "$REPO_ROOT/apps/api/prisma/.migrations-imp"/* "$REPO_ROOT/apps/api/prisma/migrations/" >&2
  rmdir "$REPO_ROOT/apps/api/prisma/.migrations-imp" 2>/dev/null || true
  docker rm "$cname" >/dev/null
  local newest
  newest="$(ls -1 "$REPO_ROOT/apps/api/prisma/migrations" | tail -1)"
  note "空迁移已导出到 apps/api/prisma/migrations/$newest——编辑 migration.sql（PostGIS 手写段用 -- AddPostGIS: 注释头）后执行 devenv migrate"
  final ok 0 name="$name" dir="$newest"
}

cmd_seed() {
  ensure_fresh_workspace
  require_services db
  run_task pnpm --filter @ne/api run seed
  final ok 0
}

# 前端入口（#12）：人类 opt-in 发布宿主端口（零端口不变量的唯一例外——浏览器在宿主机）。
# 无 bind 架构下无 HMR：改动反馈环 = 重新执行 `devenv web`（层缓存秒级重建）→ 浏览器刷新。
cmd_web() {
  local port=5173 down=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="${2:?--port 需要值}"; shift 2;;
      --down) down=1; shift;;
      *) die 2 "未知参数：$1（用法：web [--port N] [--down]）";;
    esac
  done
  if (( down )); then
    compose --profile web rm -sf web
    final ok 0 action=down
    return 0
  fi
  ensure_fresh_workspace
  WEB_PORT="$port" compose --profile web up -d web
  wait_healthy web 90
  note "web 就绪：http://localhost:$port（地图瓦片由浏览器自行拉取 OSM；地图区右键/滚轮交互）"
  final ok 0 url="http://localhost:$port" port="$port"
}

# 脚手架生成器（#12）：容器内 node 生成器。
# 文件双向通道（无 bind 架构）：宿主锚点文件（workspace.Dockerfile / app.module.ts / App.tsx）
#   经 stdin tar 进容器（补丁以宿主当前内容为基准——镜像烘焙件可能滞后）；生成物经 stdout tar 回宿主。
# app/package 类会新增 workspace 包 → 生成后自动重生成 lockfile。
# --no-refresh：跳过镜像刷新（批量连续生成时用；生成器不读镜像内的新文件目标，安全）。
# 质量门验证：devenv lint && devenv typecheck && devenv test:unit
cmd_gen() {
  local refresh=1
  [[ "${1:-}" == "--no-refresh" ]] && refresh=0 && shift
  local kind="${1:-}"; local name="${2:-}"
  case "$kind" in
    app|package|nest-module|page) ;;
    *) die 2 "用法：gen [--no-refresh] <app|package|nest-module|page> <kebab-case 名>";;
  esac
  [[ "$name" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]] || die 2 "名称须为 kebab-case：$name"
  (( refresh )) && ensure_fresh_workspace
  ev step.started target="gen $kind $name"
  tar -cf - -C "$REPO_ROOT" devenv/workspace.Dockerfile apps/api/src/app.module.ts apps/web/src/App.tsx \
    | compose run --rm -T tools node "devenv/gen/gen.mjs" "$kind" "$name" \
    | tar -x -C "$REPO_ROOT"
  ev step.completed target="gen $kind $name"
  case "$kind" in
    app|package)
      note "新增 workspace 包 → 重生成 pnpm-lock.yaml（lockgen）"
      regen_lockfile
      note "下一步：devenv build && devenv lint && devenv typecheck && devenv test:unit（生成物开箱即应全绿）"
      ;;
    *)
      note "下一步：devenv lint && devenv typecheck && devenv test:unit（生成物开箱即应全绿）"
      ;;
  esac
  final ok 0 kind="$kind" name="$name"
}

wait_healthy() { # $1=svc $2=超时秒
  local svc="$1" timeout="${2:-60}" waited=0
  while (( waited < timeout )); do
    svc_healthy "$svc" && return 0
    # 容器都没了就不用等了
    if ! docker ps -a --filter "label=com.docker.compose.project=$PROJECT_NAME" \
        --filter "label=com.docker.compose.service=$svc" --format '{{.Names}}' | grep -q .; then
      die 3 "服务 [$svc] 容器不存在。修复命令：devenv up"
    fi
    sleep 2; waited=$((waited + 2))
  done
  die 5 "等待 [$svc] 健康超时（${timeout}s）。排查：devenv logs $svc"
}

cmd_wait() {
  local svc="${1:?用法：wait <db|redis|rustfs|api> [--timeout N]}"; shift || true
  local timeout=60
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) timeout="${2:?}"; shift 2;;
      *) die 2 "未知参数：$1";;
    esac
  done
  case "$svc" in db|redis|rustfs|api|web) ;; *) die 2 "未知服务：$svc";; esac
  wait_healthy "$svc" "$timeout"
  final ok 0 service="$svc"
}

cmd_doctor() {
  local failed=0
  declare -a out
  chk() { # chk <name> <ok|fail> <detail>
    out+=("{\"check\":\"$1\",\"result\":\"$2\",\"detail\":\"$(jstr "$3")\"}")
    [[ "$2" == fail ]] && failed=1
    (( JSON )) || printf '  [%s] %-18s %s\n' "$2" "$1" "$3" >&2
  }
  (( JSON )) || note "doctor：环境体检"
  docker info >/dev/null 2>&1 && chk docker-engine ok "ok" || chk docker-engine fail "docker engine 不可用"
  docker compose version >/dev/null 2>&1 && chk compose-plugin ok "ok" || chk compose-plugin fail "compose 插件缺失"
  [[ -f "$IMAGES_LOCK" ]] && chk images-lock ok "$(head -1 "$IMAGES_LOCK" | cut -c1-60)…" || chk images-lock fail "devenv/images.lock 缺失"
  docker image inspect "$TOOLS_IMAGE" >/dev/null 2>&1 && chk tools-image ok "$TOOLS_IMAGE" || chk tools-image fail "未构建。修复命令：devenv build"
  docker image inspect "$WS_IMAGE" >/dev/null 2>&1 && chk workspace-image ok "$WS_IMAGE" || chk workspace-image fail "未构建。修复命令：devenv build"
  local s
  for s in db redis rustfs; do
    svc_healthy "$s" && chk "svc:$s" ok healthy || chk "svc:$s" fail "未健康。修复命令：devenv up"
  done
  svc_running api && chk "svc:api" ok running || chk "svc:api" fail "未运行。修复命令：devenv up"

  if (( JSON )); then
    printf '{"command":"doctor","status":"%s","exitCode":%s,"checks":[%s]}\n' \
      "$(( failed ))" "$(( failed ? 3 : 0 ))" "$(IFS=,; printf '%s' "${out[*]}")"
  else
    (( failed )) && { note "体检未通过（见上）"; exit 3; } || note "体检通过，可开工"
  fi
  exit "$(( failed ? 3 : 0 ))"
}

cmd_status() {
  if (( JSON )); then CMD=ps; cmd_ps; return 0; fi
  note "容器："
  cmd_ps
  note "锁（$LOCK_DIR）："
  ls -1 "$LOCK_DIR" 2>/dev/null | sed 's/^/  /' >&2 || true
  note "镜像锁：$(grep -c '=' "$IMAGES_LOCK" 2>/dev/null || echo 0) 条（devenv images 查看）"
}

cmd_images() {
  if [[ "${1:-}" == "--verify" ]]; then
    # 校验运行中容器镜像 digest 与锁一致：podman 的 ps 只报 tag——经容器→image RepoDigests 取 manifest sha
    set -a; . "$IMAGES_LOCK"; set +a
    local s var ref cid img digest lock_sha run_sha rc=0
    for s in db redis rustfs; do
      var="$(echo "$s" | tr 'a-z' 'A-Z')_IMAGE"
      ref="${!var}"
      lock_sha="${ref##*@}"
      cid="$(docker ps --filter "label=com.docker.compose.project=$PROJECT_NAME" \
        --filter "label=com.docker.compose.service=$s" --format '{{.ID}}' | head -1)"
      if [[ -z "$cid" ]]; then
        (( JSON )) && printf '{"service":"%s","result":"not-running"}\n' "$s" || warn "$s: 未运行"
        rc=1
        continue
      fi
      img="$(docker inspect "$cid" --format '{{.Image}}')"
      digest="$(docker image inspect "$img" --format '{{index .RepoDigests 0}}')"
      run_sha="${digest##*@}"
      if [[ "$run_sha" == "$lock_sha" ]]; then
        (( JSON )) && printf '{"service":"%s","result":"ok","digest":"%s"}\n' "$s" "$run_sha" || note "$s: ok ($run_sha)"
      else
        (( JSON )) && printf '{"service":"%s","result":"drift","locked":"%s","running":"%s"}\n' "$s" "$lock_sha" "$run_sha" || warn "$s: 漂移（锁=$lock_sha，运行=$run_sha）。修复：devenv down && devenv up"
        rc=1
      fi
    done
    exit "$rc"
  fi
  cat "$IMAGES_LOCK"
}

# ---------------------------------------------------------------------------
# e2e 顶层命令（#13）：ci / explore / verify + e2e 子命令
# ---------------------------------------------------------------------------
cmd_ci() { # 与 CI 同构：起栈→只跑复现轨道→导产物→拆栈（run_id 天然数据级隔离键）
  local rid="" full_down=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --run-id) rid="${2:?--run-id 需要值}"; shift 2;;
      --full-down) full_down=1; shift;;
      *) die 2 "未知参数：$1（用法：ci [--run-id ID] [--full-down]）";;
    esac
  done
  [[ -n "$rid" ]] || rid="$(new_run_id ci)"
  e2e_stack_up "$rid" 1
  trap 'e2e_teardown "$rid"' EXIT
  local rc=0
  e2e_run_playwright "$rid" repro || rc=$?
  e2e_export_artifacts "$rid"
  e2e_teardown "$rid"
  trap - EXIT
  (( full_down )) && compose down >/dev/null 2>&1
  if (( rc )); then
    note "复现轨道失败（exit $rc）：JSON(onlyFailures)→trace.zip 已在 .artifacts/e2e/$rid/"
    final failed "$rc" runId="$rid"; exit 4
  fi
  note "复现轨道全绿（run=$rid）"
  final ok 0 runId="$rid"
}

cmd_explore() { # 探索轨道：失败=产出（证据→缺陷报告），不是事故
  local rid keep=0 rc=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --keep) keep=1; shift;;
      *) die 2 "未知参数：$1（用法：explore [--keep]）";;
    esac
  done
  rid="$(new_run_id exp)"
  e2e_stack_up "$rid" 1
  trap 'e2e_teardown "$rid"' EXIT
  e2e_run_playwright "$rid" explore || rc=$?
  e2e_export_artifacts "$rid"
  if (( keep )); then
    trap - EXIT
    note "--keep：隔离栈保留调试（run=$rid；用后手动清理或复用同 run_id 重跑）"
  else
    e2e_teardown "$rid"
    trap - EXIT
  fi
  if (( rc )); then
    note "探索轨道发现失败（exit $rc）——这是产出：trace/video/JSON 在 .artifacts/e2e/$rid/；按 apps/e2e/defects/README.md 登记缺陷"
    final explore-found "$rc" runId="$rid"; exit 4
  fi
  note "探索轨道本轮无失败发现（run=$rid）"
  final ok 0 runId="$rid"
}

verify_removed_path() { # $1=被删路径（diff 级防降级：删记录=无条件红；删用例⇒伴随 retire）
  local path="$1" id st
  if [[ "$path" == apps/e2e/defects/DEF-*.json ]]; then
    printf '[devenv] ERROR: [diff] 缺陷记录被删除：%s（无条件红——缺陷记录永不删除，退役仍留档）\n' "$path" >&2
    return 1
  fi
  if [[ "$path" == apps/e2e/tests/repro/def-*.spec.ts ]]; then
    id="DEF-$(printf '%s' "$path" | grep -oP 'def-\K\d{4}')"
    st="$(grep -oP '"status":\s*"\K[a-z]+' "$REPO_ROOT/apps/e2e/defects/$id.json" 2>/dev/null || true)"
    if [[ "$st" != "retired" ]]; then
      printf '[devenv] ERROR: [diff] 复现用例被删除/移出：%s（须伴随 retire %s；当前状态=%s）\n' "$path" "$id" "${st:-无记录}" >&2
      return 1
    fi
  fi
  return 0
}

verify_diff_against() { # $1=基线 ref（CI 传 GITHUB_BASE_REF；本地传 origin/dev）
  local base="$1" bad=0 status path rest
  git -C "$REPO_ROOT" rev-parse --verify -q "$base^{commit}" >/dev/null || die 2 "diff 基线不可解析：$base"
  base="$(git -C "$REPO_ROOT" merge-base HEAD "$base")"
  while IFS=$'\t' read -r status path rest; do
    [[ -z "${status:-}" ]] && continue
    case "$status" in
      D)  verify_removed_path "$path" || bad=1;;
      R*) verify_removed_path "$path" || bad=1;;   # 重命名 = 删除 + 新增，旧路径按删除处理
    esac
  done < <(git -C "$REPO_ROOT" diff --name-status "$base" HEAD -- apps/e2e/defects apps/e2e/tests/repro 2>/dev/null || true)
  (( bad )) && die 7 "diff 级防降级检查失败（见上）"
}

cmd_verify() { # 质量门 + 生命周期防降级（与 CI 同一校验器；--diff-base 加 diff 级检查）
  local diff_base="" ops
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --diff-base) diff_base="${2:?--diff-base 需要值}"; shift 2;;
      *) die 2 "未知参数：$1（用法：verify [--diff-base <git-ref>]）";;
    esac
  done
  note "verify ①/③：质量门（lint / typecheck / test:unit）"
  cmd_lint
  cmd_typecheck
  cmd_test_unit
  note "verify ②/③：生命周期防降级（索引/注解/编号/门禁/注册表）"
  ops="$(mktemp)"
  e2e_cli verify --write-registry >"$ops"
  apply_e2e_ops "$ops"
  rm -f "$ops"
  if [[ -n "$diff_base" ]]; then
    note "verify ③/③：diff 级防降级（基线 $diff_base）"
    verify_diff_against "$diff_base"
  fi
  note "verify 全绿"
  final ok 0
}

cmd_e2e_report() { # 登记回填：实测复现门禁（0=复现）→ 全复现才落账 status=reported
  local id="${1:?用法：e2e report <DEF-NNNN> [--by WHO]}"; shift
  e2e_registry_lock 600
  local rid; rid="$(new_run_id rep)"
  e2e_stack_up "$rid" 0
  trap 'e2e_teardown "$rid"' EXIT
  local plan cmd attempts n=0 outcomes="" i rc2 ops
  plan="$(e2e_cli replay-plan "$id")"
  cmd="$(printf '%s\n' "$plan" | grep -P '^CMD\t' | cut -f2)"
  attempts="$(printf '%s\n' "$plan" | grep -P '^ATTEMPTS\t' | cut -f2)"
  [[ -n "$cmd" && -n "$attempts" ]] || die 10 "replay-plan 输出不完整（缺陷记录缺 replayCommand？）"
  for i in $(seq 1 "$attempts"); do
    rc2=0; e2e_replay_once "$rid" "$cmd" || rc2=$?
    outcomes+="$rc2,"
    note "复现门禁重放 $i/$attempts：exit $rc2（0=复现）"
  done
  outcomes="${outcomes%,}"
  ops="$(mktemp)"
  e2e_cli report "$id" --outcomes "$outcomes" --key-space "$rid" "$@" >"$ops"
  apply_e2e_ops "$ops"
  rm -f "$ops"
  e2e_teardown "$rid"; trap - EXIT
  final ok 0 defect="$id" attempts="$attempts" keySpace="$rid"
}

cmd_e2e_replay() { # 手动重放缺陷（诊断用）：默认按门禁下限次数
  local id="${1:?用法：e2e replay <DEF-NNNN> [--attempts N]}"; shift
  local attempts=0 rid plan cmd i rc2 reproduced=0
  [[ "${1:-}" == "--attempts" ]] && attempts="${2:?--attempts 需要值}"
  e2e_registry_lock 60
  rid="$(new_run_id rpl)"
  e2e_stack_up "$rid" 0
  trap 'e2e_teardown "$rid"' EXIT
  plan="$(e2e_cli replay-plan "$id")"
  cmd="$(printf '%s\n' "$plan" | grep -P '^CMD\t' | cut -f2)"
  local n; n="$(printf '%s\n' "$plan" | grep -P '^ATTEMPTS\t' | cut -f2)"
  (( attempts > 0 )) && n="$attempts"
  [[ -n "$cmd" ]] || die 10 "replay-plan 输出不完整"
  for i in $(seq 1 "$n"); do
    rc2=0; e2e_replay_once "$rid" "$cmd" || rc2=$?
    (( rc2 == 0 )) && reproduced=$((reproduced+1))
    note "重放 $i/$n：exit $rc2（0=复现）"
  done
  e2e_teardown "$rid"; trap - EXIT
  if (( reproduced == n )); then
    note "缺陷复现：$reproduced/$n"
    final ok 0 defect="$id" reproduced="$reproduced" attempts="$n"
  else
    note "未全部复现：$reproduced/$n（环境漂移或已修复？）"
    final not-reproduced 4 defect="$id" reproduced="$reproduced" attempts="$n"
    exit 4
  fi
}

cmd_e2e_graduate() { # 毕业事务：预检→转写→真跑校验→原子落账（含 _drafts 草稿流）
  local id="${1:?用法：e2e graduate <DEF-NNNN> [--fixed] [--by WHO]}"; shift
  e2e_registry_lock 600
  local rid; rid="$(new_run_id grad)"
  E2E_CUR_RUN_ID="$rid"
  e2e_stack_up "$rid" 1
  trap 'e2e_teardown "$rid"' EXIT
  local ops; ops="$(mktemp)"
  e2e_cli graduate "$id" "$@" >"$ops"
  apply_e2e_ops "$ops"
  rm -f "$ops"
  note "毕业完成：测试文件与缺陷记录放同一 commit（#10 决议 §6）"
  e2e_teardown "$rid"; trap - EXIT
  final ok 0 defect="$id" keySpace="$rid"
}

cmd_e2e_confirm_fix() { # 修复确认：真跑（无 fail 标记）必须通过 → 摘标记 → fixed
  local id="${1:?用法：e2e confirm-fix <DEF-NNNN> [--by WHO]}"; shift
  e2e_registry_lock 600
  local rid; rid="$(new_run_id cfx)"
  E2E_CUR_RUN_ID="$rid"
  e2e_stack_up "$rid" 1
  trap 'e2e_teardown "$rid"' EXIT
  local ops; ops="$(mktemp)"
  e2e_cli confirm-fix "$id" "$@" >"$ops"
  apply_e2e_ops "$ops"
  rm -f "$ops"
  note "修复确认完成：用例转常绿回归（fixed）"
  e2e_teardown "$rid"; trap - EXIT
  final ok 0 defect="$id" keySpace="$rid"
}

cmd_e2e() { # 子命令面（#10 决议 §9）
  local sub="${1:?用法：e2e <report|graduate|confirm-fix|retire|replay|renumber|defect> …}"; shift
  local ops
  case "$sub" in
    report)     cmd_e2e_report "$@";;
    replay)     cmd_e2e_replay "$@";;
    graduate)   cmd_e2e_graduate "$@";;
    confirm-fix) cmd_e2e_confirm_fix "$@";;
    defect)     e2e_cli defect "$@";;                       # 只读查询，stdout 直接透传
    retire)
      e2e_registry_lock 120
      ops="$(mktemp)"
      e2e_cli retire "$@" >"$ops"
      apply_e2e_ops "$ops"; rm -f "$ops"
      final ok 0 action=retire;;
    renumber)
      e2e_registry_lock 120
      ops="$(mktemp)"
      e2e_cli renumber "$@" >"$ops"
      apply_e2e_ops "$ops"; rm -f "$ops"
      final ok 0 action=renumber;;
    *) die 2 "未知 e2e 子命令：$sub";;
  esac
}

