CMD=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON=1; shift;;
    -h|--help) usage; exit 0;;
    *) CMD="$1"; shift; break;;
  esac
done
[[ -n "$CMD" ]] || { usage; exit 2; }

case "$CMD" in
  build)          cmd_build "$@";;
  up)             cmd_up "$@";;
  web)            cmd_web "$@";;
  gen)            cmd_gen "$@";;
  down)           cmd_down "$@";;
  restart)        cmd_restart "$@";;
  ps)             [[ "${1:-}" == "-a" || "${1:-}" == "--all" ]] && ALL=1 && shift; cmd_ps "$@";;
  logs)           cmd_logs "$@";;
  exec)           cmd_exec "$@";;
  shell)          cmd_shell "$@";;
  test)           cmd_test "$@";;
  test:unit)      cmd_test_unit "$@";;
  lint)           cmd_lint "$@";;
  typecheck)      cmd_typecheck "$@";;
  migrate)        cmd_migrate "$@";;
  migrate:create) cmd_migrate_create "$@";;
  seed)           cmd_seed "$@";;
  wait)           cmd_wait "$@";;
  doctor)         cmd_doctor "$@";;
  status)         cmd_status "$@";;
  images)         cmd_images "$@";;
  ci)             cmd_ci "$@";;
  explore)        cmd_explore "$@";;
  verify)         cmd_verify "$@";;
  e2e)            cmd_e2e "$@";;
  *)              usage; die 2 "未知子命令：$CMD";;
esac
