#!/usr/bin/env bash
# ============================================================================
# devenv —— 工程基座唯一入口（Spec-工程基座 §4；#56 最小空间数据开发栈 + #58 固定快照与不可变绑定 + #59 per-worktree 隔离 + #61 锁与栈使用租约）
#
# 宿主工具链零安装：本脚本只使用白名单宿主工具（bash、docker CLI + compose v2、
# git、coreutils、tar、find、jq、openssl、curl、gh；macOS 自带 bsdtar/BSD find
# 兼容所用法的）；一切 node/pnpm/prisma 执行都在容器内。
#
# 命令面权威文档：devenv/COMMANDS.md（Action | Command | 期望退出码 + JSON schema
# + 并发语义）。AGENTS.md 只放关键入口与指针。
#
# 调用形态：./devenv/devenv [--json] <子命令> [参数]
#
# 输出协议（Spec §4 三类）：
#   - 结构化命令 --json：stdout 单 JSON 或 JSONL 事件流（终值含 command/status/exitCode）；
#     进度与子进程原始输出走 stderr，不混入结果流。
#   - 透传命令（exec/shell/logs）：子进程原始流；--json 仅包装终值元数据。
#
# 退出码枚举（总表归 Spec-工程基座；7–10 e2e 专用码段由 Spec-e2e 登记，本票不用）：
#   0 成功 | 2 用法错误 | 3 环境未就绪（含引擎不在矩阵、端点解析失败）
#   4 任务失败 | 5 超时（健康等待/拉取） | 6 独占锁冲突
#   20 授权不符 | 21 私钥/签名 | 22 token 换取失败 | 23 目标未授权（认证入口）
# ============================================================================
set -Eeuo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=lib/output.sh
source "$REPO_ROOT/devenv/lib/output.sh"
# shellcheck source=lib/engine.sh
source "$REPO_ROOT/devenv/lib/engine.sh"
# shellcheck source=lib/lock.sh
source "$REPO_ROOT/devenv/lib/lock.sh"
# shellcheck source=lib/snapshot.sh
source "$REPO_ROOT/devenv/lib/snapshot.sh"
# shellcheck source=lib/stack.sh
source "$REPO_ROOT/devenv/lib/stack.sh"
# shellcheck source=lib/supply-chain.sh
source "$REPO_ROOT/devenv/lib/supply-chain.sh"

# shellcheck source=lib/ci.sh
source "$REPO_ROOT/devenv/lib/ci.sh"
# shellcheck source=lib/gen.sh
source "$REPO_ROOT/devenv/lib/gen.sh"
# shellcheck source=lib/e2e.sh
source "$REPO_ROOT/devenv/lib/e2e.sh"
# shellcheck source=lib/github-app-auth.sh
source "$REPO_ROOT/devenv/lib/github-app-auth.sh"
# shellcheck source=lib/branch-protection.sh
source "$REPO_ROOT/devenv/lib/branch-protection.sh"
# shellcheck source=lib/branch-cleanup.sh
source "$REPO_ROOT/devenv/lib/branch-cleanup.sh"

trap 'e2e_cleanup_on_exit; gen_txn_rollback; lease_release_all; lock_release_all; snapshot_cleanup' EXIT

usage() {
  cat >&2 <<'EOF'
devenv — 工程基座唯一入口（命令面权威文档：devenv/COMMANDS.md）
用法：devenv [--json] <子命令> [参数]

工程栈（一切构建/启停/观察/执行的唯一入口；禁止直接操作 compose）：
  doctor                    一键体检（端点/引擎/矩阵/锁文件/worktree 身份与凭据状态/供应链门禁/CI workflow 静态门禁/镜像/服务）；退出码=可开工与否
  prefetch                  预取镜像锁中的上游镜像（分阶段、有进度/超时、可中断续跑；机器级拉取锁）
  build [--lockgen]         固定快照构建（tools + install + turbo build；幂等；--lockgen 强制重生成 lockfile）
  up                        启动 db/api 并等待真实健康终态（幂等）
  down [--volumes]          停止（--volumes 连带清数据卷）
  restart [svc...]          重启（默认全部）
  web [--port N] [--down]   启动前端并发布宿主端口（零端口不变量唯一例外；省略 --port 引擎自动分配空闲端口，实际端口见终值/status；与栈命令互斥）
  gen <package|app> <name>  当前工作树生成器生成新 workspace 包或应用（来源路径+树哈希可核；自动补
                            workspace.Dockerfile 清单并触发 lockgen；目标已存在即拒绝；#64/#65）
  gen nest-module <name> --http|--internal --spec <路径>
                            生成契约完整的 Nest 模块（#67）：--http 生成路由常量/请求响应 schema/
                            请求与响应校验/集成测试并登记 OpenAPI 契约；--internal 仅生成 module/
                            service（不强制 HTTP 契约）；缺业务信息即停止，无部分写入
  gen page <name> --spec <路径> [--contract <契约名>]
                            生成自动注册且表单实例唯一的页面（#68）：经 RTK Query + validated 统一
                            响应校验封装消费 @ne/contracts（默认同名契约，可用 --contract 指定）；
                            表单用 React useId（多 React 根带根级前缀），附双 Form/多根/UI 旅程测试
  gen evidence              读取绑定 workspace 镜像内的 pnpm 下载证据（需 DEVENV_PNPM_EVIDENCE=1 构建；缺失即 exit 4）
  ps [-a]                   容器状态（含发布端口；--json 输出 JSONL）
  logs [svc] [-f] [--tail N] 跟随日志（透传原始流；--json 时原始流走 stderr，stdout 仅终值元数据）
  exec [svc] -- cmd...      在容器内执行（默认 tools；透传原始流；--json 同上包装）
  shell [svc]               交互 shell（默认 tools；透传原始流；--json 同 exec 包装）
  test [pattern...]         单元+集成测试（需先 up；连真实 PostGIS；运行期持共享栈租约）
  test:unit                 仅单元测试（零数据库基础设施；运行期持共享栈租约）
  lint / typecheck          ESLint / tsc --noEmit（运行期持共享栈租约）
  verify                    聚合质量门：lint + typecheck + test:unit（运行期持共享栈租约）
  migrate                   应用全部 pending 迁移到 dev 库（prisma migrate deploy）
  migrate:create --name N   生成空迁移待编辑（prisma migrate dev --create-only）
  seed                      幂等种子数据（运行期持共享栈租约）
  wait <svc> [--timeout N]  等待服务健康终态（db|redis|rustfs|api|worker|web；默认 60s）
  status                    人读总览（容器+锁+租约+镜像）
  images [--verify]         查看镜像锁与生效 DB 镜像（含覆盖来源）/ 校验运行态 digest 漂移
  supply-chain [--container] 供应链门禁：catalog/allowBuilds/冷却期/锁文件漂移静态核对；
                            --container 再核对包内 agent skills/构建脚本待审批项（默认拒绝）
  e2e build                 构建 e2e 执行器镜像（官方 Playwright 基座 + 项目运行时；
                            与 npm 包严格同版本；探索/复现 run 会自动确保它存在）
  e2e runs                  运行登记册（run id / status / live / db/bucket/queue；只读）
  e2e logs --run-id ID [svc] [-f] [--tail N]
                            观察 per-run 容器日志（透传原始流；api|worker|web，默认 api）
  explore [--run-id ID]     探索轨道：共享基础设施 + 每 run 独立库/bucket/队列键空间；
                            API/worker 绑定本 run 资源；运行期持共享栈使用租约；
                            产物导出 .artifacts/e2e/<run-id>/；发现失败=产出（exit 4）

GitHub App 认证入口（身份：GitHub App，非个人账号）：
  gh <args...>              以 App 身份执行 gh（拒绝 gh auth；拒绝 -R 指向未授权仓库）
  git-push <remote> <refspec...>
                            以 App 身份经 HTTPS 推送（只接受已配置 remote 名；目标必须授权）

分支保护与清理（不触引擎；详见 docs/agents/branch-protection.md、docs/agents/branch-cleanup.md）：
  branch-protection [--require-bypass-actors]
                            Git 保护配置漂移核对（dev 两层规则集 + archive 标签规则集 +
                            合入后自动删除设置；保存配置 ↔ GitHub 实时；匿名只读，
                            BP_GITHUB_TOKEN/GITHUB_TOKEN 存在时优先；漂移或无法核查即非零；
                            --require-bypass-actors 为管理员强校验绕过名单，须管理员令牌）
  branch-cleanup <branch> [--apply]
                            PR 合入后清理本地分支与其 worktree（窄用途，非通用 worktree 管理器）：
                            双重判断 = PR 已 squash 合入 且 本地无未保存内容；未提交文件/
                            未推送提交/合入后本地新增提交分别拒绝并列出原因；prototype/* 豁免；
                            无强制删除路径；默认 dry-run，--apply 才删除（详见 branch-cleanup.md）

测试：
  test:auth                 认证入口离线测试（不访问 GitHub）
  test:auth:integration     认证入口真实集成测试（默认只读；写操作需显式旗标）
  test:branch-protection    分支保护受控验收 harness（真实 GitHub，App 身份；分阶段，
                            需与指挥者 UI 操作交错；详见 docs/agents/branch-protection.md）
  test:branch-cleanup       分支清理与归档保护受控验收 harness（真实 GitHub，App 身份；分阶段，
                            需与指挥者 UI 操作交错；记录提交哈希；详见 docs/agents/branch-cleanup.md）
  test:devenv               命令面离线测试（引擎解析/锁与栈使用租约/输出协议/快照与不可变绑定/per-worktree 隔离/
                            供应链门禁/CI workflow 静态门禁/分支保护漂移核对/分支清理与归档/脚手架生成/e2e 隔离编排，mock docker）

退出码：0 成功 | 2 用法 | 3 环境未就绪 | 4 任务失败 | 5 超时 | 6 锁冲突 | 20–23 认证入口
EOF
}

# ---------------------------------------------------------------------------
# 工程栈子命令
# ---------------------------------------------------------------------------

cmd_doctor() {
  local failed=0 engine_ok=0
  local -a out=()
  chk() { # chk <name> <ok|warn|fail> <detail>
    out+=("{\"check\":\"$1\",\"result\":\"$2\",\"detail\":\"$(jstr "$3")\"}")
    [[ "$2" == fail ]] && failed=1
    (( JSON )) || printf '  [%s] %-18s %s\n' "$2" "$1" "$3" >&2
    return 0
  }
  (( JSON )) || note "doctor：环境体检"

  # 引擎端点/身份/版本/架构 + 矩阵（软收集：体检要报告全部检查项，不在首个失败处退出）
  if ! command -v docker >/dev/null 2>&1; then
    chk engine-endpoint fail "docker CLI 不在 PATH（白名单工具缺失）"
  elif ! engine_resolve; then
    chk engine-endpoint fail "$ENGINE_ERROR"
  elif ! engine_probe; then
    chk engine-endpoint fail "$ENGINE_ERROR"
  else
    engine_ok=1
    chk engine-endpoint ok "$ENGINE_IDENTITY $ENGINE_VERSION ($ENGINE_OS/$ENGINE_ARCH) @ ${ENGINE_ENDPOINT}（来源：${ENGINE_SOURCE}）"
    engine_report
    if engine_check_matrix; then
      chk engine-matrix ok "引擎在支持矩阵内（${ENGINE_IDENTITY}）"
    else
      chk engine-matrix fail "$ENGINE_ERROR"
    fi
  fi

  if (( engine_ok )) && docker compose version >/dev/null 2>&1; then
    chk compose-plugin ok "$(docker compose version --short 2>/dev/null || echo ok)"
  elif (( engine_ok )); then
    chk compose-plugin fail "compose v2 插件缺失"
  else
    chk compose-plugin fail "引擎不可用，无法校验 compose"
  fi

  if [[ -f "$IMAGES_LOCK" ]] && grep -q '^NODE_IMAGE=' "$IMAGES_LOCK" && grep -q '^DB_IMAGE=' "$IMAGES_LOCK" \
      && grep -q '^REDIS_IMAGE=' "$IMAGES_LOCK" && grep -q '^RUSTFS_IMAGE=' "$IMAGES_LOCK"; then
    chk images-lock ok "$IMAGES_LOCK"
    # images_load 内含 die（锁格式/覆盖格式错误）——子shell 软化为体检项
    local db_info
    if db_info="$( (images_load && printf '%s（来源：%s；kind=%s%s）' "$DB_IMAGE_EFFECTIVE" "$DB_IMAGE_SOURCE" "$DB_IMAGE_KIND_EFFECTIVE" "${DB_IMAGE_PLATFORM_EFFECTIVE:+ platform=$DB_IMAGE_PLATFORM_EFFECTIVE}") 2>&1 )"; then
      chk db-image ok "$db_info"
    else
      chk db-image fail "$db_info"
    fi
  else
    chk images-lock fail "devenv/images.lock 缺失或缺 NODE_IMAGE/DB_IMAGE/REDIS_IMAGE/RUSTFS_IMAGE 行"
    chk db-image fail "镜像锁不可用"
  fi

  # 供应链门禁（#63）：catalog/allowBuilds/冷却期/锁文件漂移/镜像锁 digest（不触引擎）
  if supply_chain_static_check "$REPO_ROOT" 0; then
    chk supply-chain ok "catalog 精确 pin / allowBuilds 版本化 / minimumReleaseAge=1440 strict / 锁文件与声明一致 / 镜像锁 digest+平台类型"
  else
    local sc_msg="" sc_e
    for sc_e in ${SC_ERRORS[@]+"${SC_ERRORS[@]}"}; do sc_msg="${sc_msg}${sc_e}；"; done
    chk supply-chain fail "$(sc_error_count) 项：${sc_msg}"
  fi

  # CI workflow 静态门禁（#71）：直接调用 compose 即拒绝——CI 的项目操作必须经
  # devenv 唯一入口（本地与 CI 同一校验器）。诚实口径：静态反例拦截 ≠ 阻止
  # 人工在终端绕过 devenv（Spec §6 同款声明，不声称已阻止）。
  if ci_workflow_scan "$REPO_ROOT"; then
    if (( CI_WF_SCANNED > 0 )); then
      chk ci-workflows ok "${CI_WF_SCANNED} 个 workflow 无直接 compose 调用（CI 项目操作经 devenv 唯一入口）"
    else
      chk ci-workflows ok "无 workflow 文件（本仓库尚未声明 CI workflow）"
    fi
  else
    chk ci-workflows fail "$(ci_workflow_error_summary)。修复：CI 中一切项目操作改经 ./devenv/devenv（唯一入口，见 devenv/COMMANDS.md）"
  fi

  # worktree 身份与 per-worktree 隔离状态（#59）：不触引擎，纯状态报告
  chk worktree ok "project=${PROJECT_NAME}（suffix=${WT_SUFFIX}；身份来源：${WT_IDENTITY_SOURCE}）；本地镜像 tag 后缀 wt-${WT_SUFFIX}；stack/migrate 锁 per-worktree、lockgen 机器级"
  local db_cred_f="${DEVENV_STATE_DIR:-$REPO_ROOT/.devenv-state}/db-credentials.env"
  if [[ -f "$db_cred_f" ]]; then
    chk db-credentials ok "每 worktree 随机口令已生成（${db_cred_f}）"
  else
    chk db-credentials ok "未生成（任一 compose 调用命令——含只读 ps/logs/down——首次执行时生成每 worktree 随机口令并持久化）"
  fi
  local storage_cred_f="${DEVENV_STATE_DIR:-$REPO_ROOT/.devenv-state}/storage-credentials.env"
  if [[ -f "$storage_cred_f" ]]; then
    chk storage-credentials ok "每 worktree 随机对象存储凭据已生成（${storage_cred_f}）"
  else
    chk storage-credentials ok "未生成（任一 compose 调用命令首次执行时生成每 worktree 随机对象存储凭据并持久化）"
  fi

  # 镜像/服务为信息项（冷启动流程 clone → doctor → prefetch → build：doctor 时未构建不判失败）
  if (( engine_ok )); then
    if docker image inspect "$TOOLS_IMAGE" >/dev/null 2>&1; then
      chk tools-image ok "$TOOLS_IMAGE"
    else
      chk tools-image warn "未构建（冷启动正常；构建命令：devenv build）"
    fi
    if docker image inspect "$WS_IMAGE" >/dev/null 2>&1; then
      chk workspace-image ok "$WS_IMAGE"
    else
      chk workspace-image warn "未构建（冷启动正常；构建命令：devenv build）"
    fi
    # 快照状态（#58）与 e2e 执行器镜像状态（#70）：一次加载，两项报告
    snapshot_state_load
    snapshot_e2e_state_load
    if [[ -n "$STATE_E2E_IMAGE_ID" ]] && docker image inspect "$STATE_E2E_IMAGE_ID" >/dev/null 2>&1; then
      chk e2e-image ok "执行器 ${STATE_E2E_IMAGE_ID:0:19}…（快照 ${STATE_E2E_SNAPSHOT_HASH:0:12}…）"
    elif docker image inspect "$E2E_IMAGE" >/dev/null 2>&1; then
      chk e2e-image warn "存在 per-worktree tag 但无不可变绑定（修复：devenv e2e build）"
    else
      chk e2e-image warn "未构建（探索/复现前：devenv e2e build，或首次 run 自动构建）"
    fi
    if [[ -z "$STATE_IMAGE_ID" && -z "$STATE_TOOLS_IMAGE_ID" ]]; then
      chk snapshot-state warn "无快照状态（冷启动正常；构建命令：devenv build）"
    else
      local ws_st="workspace 未构建" tools_st="tools 未构建"
      if [[ -n "$STATE_IMAGE_ID" ]] && docker image inspect "$STATE_IMAGE_ID" >/dev/null 2>&1; then
        ws_st="workspace ${STATE_IMAGE_ID:0:19}…"
      fi
      if [[ -n "$STATE_TOOLS_IMAGE_ID" ]] && docker image inspect "$STATE_TOOLS_IMAGE_ID" >/dev/null 2>&1; then
        tools_st="tools ${STATE_TOOLS_IMAGE_ID:0:19}…"
      fi
      chk snapshot-state ok "快照 ${STATE_SNAPSHOT_HASH:0:12}… ↔ $ws_st / $tools_st"
    fi
    local s
    for s in db redis rustfs api worker; do
      if svc_healthy "$s"; then chk "svc:$s" ok healthy;
      elif svc_running "$s"; then chk "svc:$s" warn "运行中但未健康";
      else chk "svc:$s" warn "未运行（启动命令：devenv up）"; fi
    done
    # #59 前共享项目 natural-enforcement 的遗留容器：不属于任何 worktree，
    # per-worktree down 不触碰；人工确认后清理，卷/镜像回收归 #75（宁多留勿误删）
    if docker ps -a --filter "label=com.docker.compose.project=natural-enforcement" --format '{{.Names}}' 2>/dev/null | grep -q .; then
      chk legacy-project warn "发现 #59 前共享项目 natural-enforcement 的遗留容器（不被任何 worktree 管理，不影响隔离语义）；修复：人工确认后 docker rm，资源回收归 #75"
    fi
  fi

  if (( JSON )); then
    local st="ok"; (( failed )) && st="failed"
    printf '{"command":"doctor","status":"%s","exitCode":%s,"checks":[%s]}\n' \
      "$st" "$(( failed ? 3 : 0 ))" "$(IFS=,; printf '%s' "${out[*]}")"
  else
    (( failed )) && note "体检未通过（见上）" || note "体检通过，可开工"
  fi
  exit "$(( failed ? 3 : 0 ))"
}

cmd_prefetch() {
  images_load
  # timeout 来自 coreutils（白名单）；macOS 为 gtimeout（brew coreutils）——两平台适配
  local timeout_bin
  timeout_bin="$(command -v timeout || command -v gtimeout || true)"
  [[ -n "$timeout_bin" ]] || die 3 "缺少 timeout/gtimeout（coreutils；macOS：brew install coreutils）"
  local timeout_s="${DEVENV_PREFETCH_TIMEOUT:-900}"
  # 机器级基础镜像拉取锁（#61）：跨 worktree 互斥；另一 worktree 正在 prefetch 时
  # 等待，超时 exit 6（重跑续跑）。栈使用租约只协调 per-worktree 栈，不加在此。
  lock_acquire prefetch 300
  local img rc
  for img in "$NODE_IMAGE" "$DB_IMAGE_EFFECTIVE" "$REDIS_IMAGE" "$RUSTFS_IMAGE" "$PLAYWRIGHT_IMAGE"; do
    ev pull.started image="$img" timeout="$timeout_s"
    note "prefetch：拉取 ${img}（超时 ${timeout_s}s，可中断续跑——重复执行即可）"
    rc=0
    "$timeout_bin" "$timeout_s" docker pull "$img" >&2 || rc=$?
    if (( rc == 124 )); then
      final failed 5 image="$img" hint="拉取超时（${timeout_s}s）；重跑 devenv prefetch 续跑"
      die 5 "拉取超时：${img}（${timeout_s}s）。重跑 devenv prefetch 断点续跑"
    elif (( rc != 0 )); then
      final failed 4 image="$img" hint="docker pull 退出码 $rc"
      die 4 "拉取失败：${img}（docker pull 退出码 ${rc}）。检查网络后重跑 devenv prefetch"
    fi
    ev pull.completed image="$img"
  done
  note "prefetch 完成（5 个上游镜像就绪）"
  final ok 0 images="node,db,redis,rustfs,playwright"
}

cmd_build() {
  local lockgen=0
  [[ "${1:-}" == "--lockgen" ]] && lockgen=1
  # 供应链静态门禁（#63）：普通构建 frozen install 前先核对 catalog/allowBuilds/
  # 冷却期/锁文件漂移/镜像锁。--lockgen 或首次引导（无锁文件）跳过"漂移"一项，
  # 因为该路径的目的就是重新生成锁文件；生成后仍须审查 diff 再提交。
  local sc_skip=0
  [[ -f "$REPO_ROOT/pnpm-lock.yaml" && $lockgen -eq 0 ]] || sc_skip=1
  if ! supply_chain_static_check "$REPO_ROOT" "$sc_skip"; then
    sc_print_report
    final failed 4 step="supply-chain" errors="$(sc_error_count)" hint="docs/agents/supply-chain.md"
    die 4 "供应链门禁未通过（$(sc_error_count) 项）：构建已停止。审查后经 devenv build --lockgen 更新锁文件并审查 diff；规则见 docs/agents/supply-chain.md"
  fi
  lock_acquire "stack-$WT_SUFFIX" 120
  # gen 与 build 互斥（Spec §4 锁表；#64）：gen 持 per-worktree 源码锁，build
  # 消费源码/manifest 也必须持有同一把——build 的 stack 锁只协调栈资源，
  # 不覆盖源码生成。取得顺序固定 stack → gen →（触发时）机器级 lockgen。
  lock_acquire "gen-$WT_SUFFIX" 120
  local t0=$(( $(date +%s) ))
  images_load

  # 固定输入快照（#58）：一次采集覆盖未提交修改/新增/删除及 Dockerfile、构建脚本、
  # 锁文件等构建输入；采集后构建只读快照（git 对象库），不再读取活工作树。
  local s dir
  s="$(snapshot_capture)"
  ev snapshot.captured hash="$s"

  # tools 基础镜像：同一快照链路核对/重建（NODE_IMAGE 取自快照内 images.lock）；
  # DB_IMAGE 是运行时输入（compose 注入），仍经 images_load 生效值 + 覆盖报告
  ensure_tools_image "$s"

  # 首次引导 / 显式 --lockgen：lockfile 经 lockgen 靶生成后 docker cp 导出（全程容器内，无 bind mount）
  snapshot_materialize_new "$s"
  dir="$SNAPSHOT_MATERIALIZED_DIR"
  if [[ ! -f "$dir/pnpm-lock.yaml" ]] || (( lockgen )); then
    note "lockgen：重生成 pnpm-lock.yaml（新增/变更 workspace 包后必须；生成后请随 git 提交并审查 diff）"
    regen_lockfile "$dir"
    # lockfile 已导出回工作树 → 重新采集快照再构建 workspace（构建输入必须含新 lockfile）；
    # 重新采集后基础镜像输入若变，必须重新核对（评审要求）
    s="$(snapshot_capture)"
    ev snapshot.captured hash="$s" reason="lockgen"
    snapshot_discard "$dir"
    ensure_tools_image "$s"
  fi
  snapshot_discard "$dir"

  build_workspace_from_snapshot "$s"

  note "build 完成"
  final ok 0 duration="$(( $(date +%s) - t0 ))s" snapshot="$s"
}

regen_lockfile() { # $1=快照物化目录；lockgen 靶生成 lockfile 后 docker cp 导出（--lockfile-only 不拉包）
  local dir="$1" target="lockgen"
  ev step.started target="lockgen"
  # lockgen 用机器级共享资源（ne-lockgen:tmp 标签 + 同名遗留容器清理），跨 worktree
  # 互斥（#59：stack/migrate 锁 per-worktree，lockgen 机器级）；持锁期间其它 worktree
  # 的 build 触发 lockgen 会等待或 exit 6（重跑即续）
  lock_acquire lockgen 300
  # 前置清理：上次异常退出可能留下持锁容器（image in use → rmi 失败连锁，原型实测坑）
  # （不用 xargs -r：macOS 宿主 xargs 无 -r）
  local stale_cids
  stale_cids="$(docker ps -a --filter ancestor=ne-lockgen:tmp -q)"
  # shellcheck disable=SC2086
  [[ -n "$stale_cids" ]] && docker rm -f $stale_cids >/dev/null 2>&1 || true
  docker rmi -f ne-lockgen:tmp >/dev/null 2>&1 || true
  # 首引导（快照内无 lockfile）走 lockgen-fresh 全量解析；有 lockfile 走增量解析（#54 §六.2）
  [[ -f "$dir/pnpm-lock.yaml" ]] || target="lockgen-fresh"
  # 基础镜像经 build-arg 绑定 tools 内容寻址别名 tag（tag 名内嵌 tools 自身 ID，
  # 不可变语义与 ID 等价，#71：BuildKit 不支持 FROM 裸 image ID，见 stack.sh）
  run_step "lockgen 镜像构建" \
    docker build -q -f "$dir/devenv/workspace.Dockerfile" --target "$target" -t ne-lockgen:tmp \
      --build-arg "TOOLS_IMAGE=$(tools_immutable_ref)" "$dir"
  local cid
  cid="$(docker create ne-lockgen:tmp)"
  run_step "lockfile 导出" docker cp "$cid":/workspace/pnpm-lock.yaml "$REPO_ROOT/pnpm-lock.yaml"
  docker rm "$cid" >/dev/null; docker rmi ne-lockgen:tmp >/dev/null
  ev step.completed target="lockgen"
}

cmd_up() {
  lock_acquire "stack-$WT_SUFFIX" 60
  ensure_fresh_workspace
  # 顺序：基础设施健康（db/redis/rustfs）→ 迁移幂等应用（fresh clone 的 SPEC 冷启动流
  # 无独立 migrate 步，up 必须交付"真实健康终态"= 可用 schema）→ api/worker 启动
  # （不服务于无 schema 窗口期；worker 依赖同源队列与对象存储）
  run_step "基础设施启动（db/redis/rustfs）" compose up -d db redis rustfs
  ev wait.started service="db"
  wait_healthy db 180
  ev wait.ok service="db"
  ev wait.started service="redis"
  wait_healthy redis 60
  ev wait.ok service="redis"
  ev wait.started service="rustfs"
  wait_healthy rustfs 120
  ev wait.ok service="rustfs"
  ev step.started target="migrate deploy"
  run_step "迁移应用（prisma migrate deploy）" \
    in_tools pnpm --filter @ne/api exec prisma migrate deploy
  ev step.completed target="migrate deploy"
  run_step "api/worker 启动" compose up -d api worker
  ev wait.started service="api"
  wait_healthy api 120
  ev wait.ok service="api"
  verify_svc_image api  # 启动核对：运行容器 == 本次构建的不可变镜像标识（#58）
  ev wait.started service="worker"
  wait_healthy worker 120
  ev wait.ok service="worker"
  verify_svc_image worker  # worker 与 api 同镜像，同样不可变绑定
  note "全部服务健康（db, redis, rustfs, api, worker），迁移已应用"
  final ok 0 services="db,redis,rustfs,api,worker"
}

cmd_down() {
  lock_acquire "stack-$WT_SUFFIX" 60
  local args=(--remove-orphans) vol=kept
  # --remove-orphans：清掉已不在 compose 文件中的本项目容器（如原型遗留的 redis/rustfs）；
  # 仅本 worktree 项目范围（-p per-worktree）——#59 前共享项目 natural-enforcement 的
  # 遗留资源不在此列（doctor 会 warn；回收归 #75）
  [[ "${1:-}" == "--volumes" ]] && args+=(-v) && vol=removed
  run_step "栈停止" compose down "${args[@]}"
  final ok 0 volumes="$vol"
}

cmd_restart() {
  lock_acquire "stack-$WT_SUFFIX" 60
  run_step "栈重启" compose restart "$@"
  final ok 0 services="${*:-all}"
}

cmd_ps() {
  local -a ps_args=()
  [[ -n "${ALL:-}" ]] && ps_args+=(-a)
  ps_args+=(--filter "label=com.docker.compose.project=$PROJECT_NAME")
  if (( JSON )); then
    docker ps "${ps_args[@]}" --format '{{json .}}'
  else
    docker ps "${ps_args[@]}" --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
  fi
}

cmd_logs() { run_passthrough compose logs "$@"; }  # 透传命令：子进程原始流（--json 包装终值元数据）

cmd_exec() {
  local svc="tools"
  if [[ "${1:-}" != "--" && "${1:-}" != "" && "${1:-}" != -* ]]; then svc="$1"; shift; fi
  [[ "${1:-}" == "--" ]] && shift
  [[ $# -gt 0 ]] || die 2 "exec 需要命令：devenv exec [svc] -- cmd..."
  if [[ "$svc" == "tools" ]]; then
    run_passthrough in_tools "$@"
  else
    svc_running "$svc" || die 3 "服务 [$svc] 未运行。修复命令：devenv up"
    run_passthrough compose exec "$svc" "$@"
  fi
}

cmd_shell() {
  local svc="${1:-tools}"
  if [[ "$svc" == "tools" ]]; then
    run_passthrough in_tools bash
  else
    svc_running "$svc" || die 3 "服务 [$svc] 未运行。修复命令：devenv up"
    run_passthrough compose exec "$svc" bash
  fi
}

run_task() { # $@ = 容器内命令；任务失败 → 退出码 4（终值 exitCode=4，子进程码入 taskRc）
  # 防御 #56 起潜伏的真 bug：宿主函数名（run_gate）曾被直接传进容器执行。
  # 容器内没有宿主 bash 函数——这类调用在本机响亮失败，而不是离线 mock 下被吞。
  if declare -F "${1:-}" >/dev/null 2>&1; then
    die 2 "内部错误：run_task 只接受容器内可执行命令，收到宿主函数名：$1（质量门请经 run_gate_task 调用）"
  fi
  # 子进程原始输出分流到 stderr（--json 时 stdout 只放结果流，Spec §4 输出协议）
  local rc=0
  in_tools "$@" >&2 || rc=$?
  if (( rc )); then
    final failed 4 taskRc="$rc" hint="任务命令退出码 ${rc}（完整输出见上方 stderr）"
    exit 4
  fi
}

# 质量门执行：run_gate 是宿主函数（内部自行 in_tools），直接调用——失败映射
# exit 4，与 run_task 同口径（防漂移：lint/typecheck/test:unit 与 verify 共用 run_gate）
run_gate_task() {
  local gate="$1" rc=0
  run_gate "$gate" || rc=$?
  if (( rc )); then
    final failed 4 taskRc="$rc" hint="质量门 $gate 退出码 ${rc}（完整输出见上方 stderr）"
    exit 4
  fi
}

# 质量门单一事实源（cmd_lint/cmd_typecheck/cmd_test_unit 与 cmd_verify 共用，防漂移）
run_gate() {
  case "$1" in
    lint)      in_tools pnpm -w exec eslint . >&2 ;;
    typecheck) in_tools pnpm -r run typecheck >&2 ;;
    test:unit) in_tools pnpm -r run test:unit >&2 ;;
    *) die 2 "未知质量门：$1（可选：lint|typecheck|test:unit）" ;;
  esac
}

cmd_test() {
  lease_acquire "stack-$WT_SUFFIX" 120  # 栈使用租约（#61）：测试运行期与拆栈/迁移/重启互斥
  ensure_fresh_workspace
  # #69：证据集成测试连真实 PostGIS + Redis + rustfs（worker 由测试进程内的独立
  # Nest 上下文启动，使用随机队列名避免与运行中的 compose worker 竞争）。
  require_services db redis rustfs
  if (( $# )); then
    run_task pnpm --filter @ne/api exec vitest run "$@"
  else
    # 运行期不走 turbo（podman 场景 turbo 缓存/日志写入有 EACCES 前科，原型 NOTES）；
    # turbo 只用于镜像构建期。pnpm -r --no-bail = 全收集后汇总失败。
    run_task pnpm -r --no-bail run test
  fi
  final ok 0 scope=all
}

cmd_test_unit() { lease_acquire "stack-$WT_SUFFIX" 120; ensure_fresh_workspace; run_gate_task test:unit; final ok 0 scope=unit; }
cmd_lint()      { lease_acquire "stack-$WT_SUFFIX" 120; ensure_fresh_workspace; run_gate_task lint; final ok 0; }
cmd_typecheck() { lease_acquire "stack-$WT_SUFFIX" 120; ensure_fresh_workspace; run_gate_task typecheck; final ok 0; }

# verify：聚合确定性质量门（Spec §6：lint + typecheck + test:unit；e2e 生命周期校验归
# Spec-e2e 体系，本票不含）。本地与 CI 同一入口同一校验器。各门独立收集结果，
# 任一失败 → 退出码 4。
cmd_verify() {
  lease_acquire "stack-$WT_SUFFIX" 120  # 栈使用租约（#61）：质量门运行期与拆栈/迁移互斥
  ensure_fresh_workspace
  # 不用关联数组（macOS 宿主 bash 3.2 不支持）——逐门记录
  local r_lint="" r_typecheck="" r_unit=""
  local g rc res failed=0
  for g in lint typecheck test:unit; do
    ev gate.started gate="$g"
    rc=0
    run_gate "$g" || rc=$?
    if (( rc )); then failed=1; res="fail($rc)"; else res="ok"; fi
    case "$g" in
      lint) r_lint="$res" ;; typecheck) r_typecheck="$res" ;; test:unit) r_unit="$res" ;;
    esac
    ev gate.completed gate="$g" result="$res"
  done
  if (( failed )); then
    final failed 4 lint="$r_lint" typecheck="$r_typecheck" test_unit="$r_unit"
    die 4 "verify 未通过：lint=$r_lint typecheck=$r_typecheck test:unit=$r_unit"
  fi
  note "verify 全绿（lint + typecheck + test:unit）"
  final ok 0 lint=ok typecheck=ok test_unit=ok
}

cmd_migrate() {
  lock_acquire "stack-$WT_SUFFIX" 10
  lock_acquire "migrate-$WT_SUFFIX" 10
  ensure_fresh_workspace
  require_services db
  run_task pnpm --filter @ne/api exec prisma migrate deploy
  final ok 0 mode=deploy
}

cmd_migrate_create() {
  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --name) name="${2:?--name 需要值}"; shift 2;;
      *) die 2 "未知参数：$1（用法：migrate:create --name <snake_case 名>）";;
    esac
  done
  [[ -n "$name" ]] || die 2 "缺 --name"
  lock_acquire "stack-$WT_SUFFIX" 10
  lock_acquire "migrate-$WT_SUFFIX" 10
  ensure_fresh_workspace
  require_services db
  # 无 bind 架构：迁移文件生成在容器内——用留名容器 + docker cp 导出（--rm 会丢文件）；
  # 镜像内容物为 root 属主，故以 root 身份运行写入；容器名 per-worktree（机器级唯一）
  local cname="ne-migrate-create-$WT_SUFFIX"
  docker rm -f "$cname" >/dev/null 2>&1 || true
  compose run --name "$cname" -u 0:0 tools \
    pnpm --filter @ne/api exec prisma migrate dev --create-only --name "$name" >&2
  # 容器已退出：docker cp 支持停止态容器——整目录导出后合并
  mkdir -p "$REPO_ROOT/apps/api/prisma/migrations"
  rm -rf "$REPO_ROOT/apps/api/prisma/.migrations-imp"
  docker cp "$cname:/workspace/apps/api/prisma/migrations" "$REPO_ROOT/apps/api/prisma/.migrations-imp" >&2
  mv "$REPO_ROOT/apps/api/prisma/.migrations-imp"/* "$REPO_ROOT/apps/api/prisma/migrations/" >&2
  rmdir "$REPO_ROOT/apps/api/prisma/.migrations-imp" 2>/dev/null || true
  docker rm "$cname" >/dev/null
  local newest
  # 只取时间戳目录（migration_lock.toml 按字母序排在目录之后，须排除——评审实测）
  newest="$(ls -1 "$REPO_ROOT/apps/api/prisma/migrations" | grep -v '^migration_lock\.toml$' | tail -1)"
  note "空迁移已导出到 apps/api/prisma/migrations/${newest}——编辑 migration.sql（PostGIS 手写段用 -- AddPostGIS: 注释头）后执行 devenv migrate"
  final ok 0 name="$name" dir="$newest"
}

cmd_seed() {
  lease_acquire "stack-$WT_SUFFIX" 120  # 栈使用租约（#61）：种子运行期与拆栈/迁移互斥
  ensure_fresh_workspace
  require_services db
  run_task pnpm --filter @ne/api run seed
  final ok 0
}

# 脚手架生成器（#64/#65/#67；Spec §5）：当前工作树的完整 `devenv/gen/` 集合经
# stdin tar 在容器内执行（镜像内无烘焙副本），生成物经 stdout tar 回传；宿主校验
# 清单/哈希后事务式落盘。package/app 自动补 workspace.Dockerfile 两靶 manifest COPY
# 并触发机器级 lockgen（只接受新增 importer 的预期 lockfile diff）；nest-module
# HTTP kind 生成 @ne/contracts 契约与 OpenAPI 登记，internal kind 不生成 HTTP 契约；
# 二者按整行锚点登记 app.module.ts，且不新增 workspace 包（不触发 lockgen）。
# ============================================================================
# gen evidence —— 读取当前不可变 workspace 镜像内的 pnpm 下载证据（#64）
# ----------------------------------------------------------------------------
# 证据由 workspace.Dockerfile 的 deps 层在 PNPM_EVIDENCE=1 时写入镜像：
# /workspace/.devenv/pnpm-install.json（ndjson 事件摘要，见
# devenv/supply-chain/pnpm-evidence.mjs）。本命令只从绑定镜像读取，不重建、
# 不触栈；证据缺失、事件流不完整（complete=false）或含错误事件（errors>0）
# → exit 4「无法验收」。非 --json 时 stdout 为单行紧凑证据 JSON；--json 时另有
# engine 事件（JSONL）。损坏证据先校验、不会把非 JSON 写进 stdout。
cmd_gen_evidence() {
  snapshot_state_load
  [[ -n "$STATE_IMAGE_ID" ]] \
    || die 4 "无 workspace 镜像绑定：先 DEVENV_PNPM_EVIDENCE=1 devenv build（无下载证据，无法验收）"
  local json compact
  if ! json="$(docker run --rm --network none --read-only --entrypoint sh \
        "$STATE_IMAGE_ID" -c 'cat /workspace/.devenv/pnpm-install.json' 2>/dev/null)"; then
    die 4 "镜像 ${STATE_IMAGE_ID} 内无 /workspace/.devenv/pnpm-install.json（构建未设 DEVENV_PNPM_EVIDENCE=1）——无下载证据，无法验收"
  fi
  # 先校验再输出：损坏的证据不得把非 JSON 写进 stdout（输出协议）。
  jq -e . <<<"$json" >/dev/null 2>&1 \
    || die 4 "下载证据不是合法 JSON（镜像 ${STATE_IMAGE_ID}）——无法验收"
  compact="$(jq -c . <<<"$json")"
  [[ "$(jq -r '.complete // false' <<<"$json")" == "true" ]] \
    || { printf '%s\n' "$compact"; die 4 "下载证据事件流不完整（complete=false）——无法验收，不默认通过"; }
  [[ "$(jq -r '.errors // 0' <<<"$json")" == "0" ]] \
    || { printf '%s\n' "$compact"; die 4 "下载证据含 pnpm 错误事件（errors>0）——无法验收，不默认通过"; }
  printf '%s\n' "$compact"
  return 0
}
# 锁关系（#61 一致）：gen 持 per-worktree gen-<wt> 源码锁；build 也持该锁（互斥）；
# package/app 触发 lockgen 取机器级 lockgen 锁；nest-module 不新增 workspace 包，
# 不触发 lockgen。gen 不做栈变更，不取栈使用租约。
cmd_gen() {
  # 下载证据读取（#64 验收）：读取当前绑定 workspace 镜像内构建期记录的
  # /workspace/.devenv/pnpm-install.json。构建须设 DEVENV_PNPM_EVIDENCE=1；
  # 证据不存在/流不完整一律 exit 4（「无法验收」，不默认通过）。
  if [[ "${1:-}" == "evidence" ]]; then
    shift
    [[ $# -eq 0 ]] || die 2 "多余参数：$1（用法：gen evidence）"
    cmd_gen_evidence
    return 0
  fi
  local kind="" name="" variant="" spec="" contract=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) usage; exit 0 ;;
      --http)
        [[ -z "$variant" ]] || die 2 "nest-module 只接受一个 --http|--internal"
        variant="http"; shift ;;
      --internal)
        [[ -z "$variant" ]] || die 2 "nest-module 只接受一个 --http|--internal"
        variant="internal"; shift ;;
      --spec)
        [[ -n "${2:-}" ]] || die 2 "--spec 需要值（仓库相对路径）"
        [[ -z "$spec" ]] || die 2 "--spec 只能出现一次"
        spec="$2"; shift 2 ;;
      --contract)
        [[ -n "${2:-}" ]] || die 2 "--contract 需要值（kebab-case 契约名）"
        [[ -z "$contract" ]] || die 2 "--contract 只能出现一次"
        contract="$2"; shift 2 ;;
      -*) die 2 "未知参数：$1（用法：gen <package|app|nest-module|page> <kebab-case 名>）" ;;
      *)
        if [[ -z "$kind" ]]; then kind="$1"
        elif [[ -z "$name" ]]; then name="$1"
        else die 2 "多余参数：$1（用法：gen <package|app|nest-module|page> <kebab-case 名>）"; fi
        shift ;;
    esac
  done
  [[ -n "$kind" && -n "$name" ]] \
    || die 2 "用法：gen <package|app|nest-module|page> <kebab-case 名>（nest-module 需 --http|--internal --spec <路径>；page 需 --spec <路径> [--contract <契约名>]）"
  [[ "$name" =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ ]] \
    || die 2 "名称须为 kebab-case（小写字母数字+连字符）：${name}"
  case "$kind" in
    package|app)
      [[ -z "$variant" && -z "$spec" && -z "$contract" ]] \
        || die 2 "gen ${kind} 不接受 --http/--internal/--spec/--contract"
      [[ -f "$REPO_ROOT/pnpm-lock.yaml" ]] \
        || die 4 "缺 pnpm-lock.yaml 基线：先用 devenv build --lockgen 建立锁文件基线并审查后重试（gen 需要可比较的旧锁文件）"
      ;;
    nest-module)
      [[ -z "$contract" ]] \
        || die 2 "gen nest-module 不接受 --contract（仅 page 使用）"
      [[ "$variant" == "http" || "$variant" == "internal" ]] \
        || die 2 "gen nest-module 需要且只接受一个 --http|--internal（HTTP 契约联动 / 内部服务）"
      gen_spec_validate "$spec" "$name" "$variant"
      ;;
    page)
      [[ -z "$variant" ]] \
        || die 2 "gen page 不接受 --http/--internal（仅 nest-module 使用）"
      [[ -n "$contract" ]] || contract="$name"
      gen_spec_validate "$spec" "$name" "page"
      gen_page_contract_validate "$contract" "$spec"
      ;;
    *) die 2 "未知 kind：${kind}（当前可选：package | app | nest-module | page）" ;;
  esac

  # 源码锁（per-worktree）：与其它 gen、与 build 互斥（build 取得同一把）
  lock_acquire "gen-$WT_SUFFIX" 120
  gen_host_preflight "$kind" "$name" "$variant"
  local t0; t0="$(date +%s)"

  # 来源快照：完整生成器集合 + 锚点（工作树未提交修改/新增/删除均覆盖）。
  # 报告宿主来源路径 + 生成器子树哈希；内容集哈希由宿主/容器双方重算核对。
  local s
  s="$(snapshot_capture)"
  gen_source_verify "$s"
  GEN_SET_SHA256="$(gen_set_hash_from_tree "$s")" \
    || die 4 "生成器集合哈希计算失败（快照 ${s}:devenv/gen）"
  ev gen.source path="$REPO_ROOT/devenv/gen" treeHash="$GEN_SOURCE_TREE" \
    setHash="$GEN_SET_SHA256" files="$GEN_SOURCE_FILES" snapshot="$s"
  note "生成器来源：${REPO_ROOT}/devenv/gen（子树哈希 ${GEN_SOURCE_TREE}；集哈希 ${GEN_SET_SHA256}；${GEN_SOURCE_FILES} 个文件）"
  if [[ "$kind" == "nest-module" || "$kind" == "page" ]]; then
    git -C "$REPO_ROOT" cat-file -e "${s}:${spec}" 2>/dev/null \
      || die 4 "spec 不在本次输入快照：${spec}（工作树在采集期间被修改；未写入任何文件）"
  fi
  if [[ "$kind" == "page" ]]; then
    git -C "$REPO_ROOT" cat-file -e "${s}:packages/contracts/src/${contract}.ts" 2>/dev/null \
      || die 4 "契约不在本次输入快照：packages/contracts/src/${contract}.ts（工作树在采集期间被修改；未写入任何文件）"
  fi

  # 生成器容器基座：tools 不可变镜像（node + tar；镜像内无 devenv/gen 副本）
  ensure_tools_image "$s"

  # 仓库内事务目录（同一文件系统，rename 原子；.devenv-state gitignored，不进快照）
  mkdir -p "${DEVENV_STATE_DIR:-$REPO_ROOT/.devenv-state}"
  local txn
  txn="$(mktemp -d "${DEVENV_STATE_DIR:-$REPO_ROOT/.devenv-state}/gen-txn.XXXXXX")" \
    || die 4 "无法创建 gen 事务目录（${DEVENV_STATE_DIR:-$REPO_ROOT/.devenv-state}）"
  SNAPSHOT_TMPDIRS+=("$txn")  # 复用 EXIT 清理

  gen_run_container "$txn" "$kind" "$name" "$variant" "$spec" "$s" "$contract"
  local stage="$txn/stage" applied_files applied_patches
  gen_stage_output "$txn" "$stage" "$kind" "$name" "$variant" "$spec" "$s" "$contract"
  gen_apply_transaction "$stage" "$txn" "$kind" "$name" "$variant" "$s"
  applied_files="$(jq '.files | length' "$stage/$GEN_MANIFEST_NAME")"
  applied_patches="$(jq '.patches | length' "$stage/$GEN_MANIFEST_NAME")"
  ev gen.applied files="$applied_files" patches="$applied_patches"

  # nest-module / page：不新增 workspace 包/依赖 → 不触发 lockgen；仍做静态供应链门禁。
  if [[ "$kind" == "nest-module" || "$kind" == "page" ]]; then
    if ! supply_chain_static_check "$REPO_ROOT" 0; then
      sc_print_report
      final failed 4 step="supply-chain" errors="$(sc_error_count)" hint="docs/agents/supply-chain.md"
      die 4 "gen ${kind} 后供应链门禁未通过（$(sc_error_count) 项）；已回滚生成物"
    fi
    gen_txn_commit
    if [[ "$kind" == "nest-module" ]]; then
      note "gen nest-module 完成：${variant}（无需 lockgen：未新增 workspace 包/依赖）"
      note "下一步：devenv verify（lint + typecheck + test:unit）"
      final ok 0 kind="$kind" name="$name" variant="$variant" spec="$spec" \
        sourcePath="$REPO_ROOT/devenv/gen" treeHash="$GEN_SOURCE_TREE" setHash="$GEN_SET_SHA256" \
        files="$GEN_SOURCE_FILES" patches="$applied_patches" lockgen="not-required" \
        duration="$(( $(date +%s) - t0 ))s"
    else
      note "gen page 完成：apps/web/src/pages/${name}/（契约 ${contract}；无需 lockgen：未新增 workspace 包/依赖）"
      note "下一步：devenv verify（lint + typecheck + test:unit）与 devenv web 联调"
      final ok 0 kind="$kind" name="$name" contract="$contract" spec="$spec" \
        sourcePath="$REPO_ROOT/devenv/gen" treeHash="$GEN_SOURCE_TREE" setHash="$GEN_SET_SHA256" \
        files="$GEN_SOURCE_FILES" patches="$applied_patches" lockgen="not-required" \
        duration="$(( $(date +%s) - t0 ))s"
    fi
    return 0
  fi

  # 生成后的快照 → 机器级 lockgen（新增 workspace 包/应用必须进入 lockfile）
  local s2 dir2
  s2="$(snapshot_capture)"
  ev snapshot.captured hash="$s2" reason="gen"
  snapshot_materialize_new "$s2"
  dir2="$SNAPSHOT_MATERIALIZED_DIR"
  ensure_tools_image "$s2"
  cp -p "$REPO_ROOT/pnpm-lock.yaml" "$txn/pnpm-lock.old.yaml" \
    || die 4 "旧锁文件备份失败（未触发 lockgen；生成物保留供审查）"
  note "新 workspace ${kind} 已落盘 → 触发 lockgen（机器级锁；只接受新增 importer 的预期 diff）"
  regen_lockfile "$dir2"
  snapshot_discard "$dir2"

  local importer
  importer="$(gen_target_dir "$kind")/$name"
  gen_lockfile_has_importer "$REPO_ROOT/pnpm-lock.yaml" "$importer" \
    || { final failed 4 step="lockgen" importer="$importer"; gen_txn_commit
         die 4 "lockgen 未将新 ${kind} 纳入 lockfile importer（${importer}）；已停止，请审查 pnpm-lock.yaml 与 workspace.Dockerfile"; }
  if ! gen_lockfile_diff_expected "$txn/pnpm-lock.old.yaml" "$REPO_ROOT/pnpm-lock.yaml" "$importer"; then
    gen_txn_commit  # 保留生成物与锁文件供审查（非预期 diff 需要人/agent 判断）
    final failed 4 step="lockfile-review" importer="$importer" \
      hint="审查 pnpm-lock.yaml diff；非预期变化需修正生成器/依赖后重新 gen"
    die 4 "非预期 lockfile diff：已停止并要求审查（生成物与锁文件保留）。去掉 ${importer} importer 后仍与旧锁文件不同——不得自动接受"
  fi
  ev gen.lockfile result="expected" importer="$importer"

  # 锁文件 ↔ 声明静态门禁（与 build 同一规则；失败保留现场供审查）
  if ! supply_chain_static_check "$REPO_ROOT" 0; then
    sc_print_report
    gen_txn_commit
    final failed 4 step="supply-chain" errors="$(sc_error_count)" hint="docs/agents/supply-chain.md"
    die 4 "lockgen 后供应链门禁未通过（$(sc_error_count) 项）；生成物与锁文件保留供审查"
  fi

  gen_txn_commit
  note "gen ${kind} 完成：${importer}（lockgen diff=expected）"
  note "下一步：devenv verify（lint + typecheck + test:unit），审查 pnpm-lock.yaml diff 后随 git 提交"
  final ok 0 kind="$kind" name="$name" sourcePath="$REPO_ROOT/devenv/gen" \
    treeHash="$GEN_SOURCE_TREE" setHash="$GEN_SET_SHA256" files="$GEN_SOURCE_FILES" \
    importer="$importer" lockgen="ok" lockfileDiff="expected" \
    duration="$(( $(date +%s) - t0 ))s"
}

# 前端入口：人类/agent 显式 opt-in 发布宿主端口（零宿主端口不变量的唯一例外——
# 浏览器在宿主机）。无 bind 架构下无 HMR：改动反馈环 = 重新执行 devenv web
# （层缓存秒级重建）→ 浏览器刷新。
# 并发端口分配（#62，Spec「并发端口分配」）：省略 --port 时注入裸容器端口，引擎在
# 绑定时原子分配空闲宿主端口（两进程并发 web 实际成功、天然不同端口；判据是绑定
# 结果，不是探测时空闲）；实际端口经 docker port 回读，进 --json 终值与 status。
# 需要固定地址（人读书签等）时显式 --port N——冲突在引擎绑定时真实失败后诊断占用者。
cmd_web() {
  local port="" down=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="${2:?--port 需要值}"; shift 2;;
      --down) down=1; shift;;
      *) die 2 "未知参数：$1（用法：web [--port N] [--down]）";;
    esac
  done
  if [[ -n "$port" ]]; then
    [[ "$port" =~ ^[0-9]+$ ]] && (( 10#$port >= 1 && 10#$port <= 65535 )) \
      || die 2 "--port 需要 1-65535 的数字：$port"
  fi
  if (( down )); then
    lock_acquire "stack-$WT_SUFFIX" 60  # web --down 也是栈变更（#61：复合过程整体持锁）
    compose --profile web rm -sf web
    final ok 0 action=down
    return 0
  fi
  lock_acquire "stack-$WT_SUFFIX" 60  # web 做栈变更（构建+启动），与 down/restart 等互斥（COMMANDS.md 锁表）
  ensure_fresh_workspace
  # 省略 --port → 裸容器端口（引擎运行时分配）；显式 --port → 固定发布
  local spec="4173"
  [[ -n "$port" ]] && spec="$port:4173"
  local rc=0
  WEB_PORT_SPEC="$spec" compose --profile web up -d web >&2 || rc=$?
  if (( rc )); then
    web_bind_failure_diagnose "$port"  # 确认端口占用 → die 3（含占用者与内嵌修复命令）
    final failed 4 step="web 启动" taskRc="$rc"
    die 4 "web 启动失败（compose 退出码 ${rc}，完整输出见上方 stderr）"
  fi
  wait_healthy web 120
  verify_svc_image web  # 启动核对：运行容器 == 本次构建的不可变镜像标识（#58）
  local actual
  actual="$(web_actual_port)"
  [[ -n "$actual" ]] || { final failed 4 step="web 端口回读"; die 4 "web 已健康但无法回读实际宿主端口（docker port 为空）。排查：devenv ps；devenv logs web"; }
  note "web 就绪：http://localhost:${actual}（地图瓦片由浏览器自行拉取 OSM）"
  final ok 0 url="http://localhost:$actual" port="$actual"
}

cmd_wait() {
  local svc="${1:?用法：wait <db|redis|rustfs|api|worker|web> [--timeout N]}"; shift || true
  local timeout=60
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) timeout="${2:?}"; shift 2;;
      *) die 2 "未知参数：$1";;
    esac
  done
  case "$svc" in db|redis|rustfs|api|worker|web) ;; *) die 2 "未知服务：${svc}（可选：db|redis|rustfs|api|worker|web）";; esac
  wait_healthy "$svc" "$timeout"
  final ok 0 service="$svc"
}

cmd_status() {
  if (( JSON )); then
    # 结构化总览：容器 JSONL + 终值（worktree 身份+锁+镜像生效值+快照状态），不静默退化成 ps
    docker ps --filter "label=com.docker.compose.project=$PROJECT_NAME" --format '{{json .}}'
    images_load
    snapshot_state_load
    # 凭据只读报告（status 不生成状态）：存在=stored，否则 none（首次 compose 调用生成）
    local cred_origin="none"
    [[ -f "${DEVENV_STATE_DIR:-$REPO_ROOT/.devenv-state}/db-credentials.env" ]] && cred_origin="stored"
    local storage_cred_origin="none"
    [[ -f "${DEVENV_STATE_DIR:-$REPO_ROOT/.devenv-state}/storage-credentials.env" ]] && storage_cred_origin="stored"
    # 租约只读报告（#61）：stale 仅标注，不清理（status 是只读命令）
    local leases="none"
    leases="$(lease_report_all | tr '\n' ';' | sed 's/;$//')"
    [[ -n "$leases" ]] || leases="none"
    # web 实际宿主端口（#62）：按本 worktree 项目标签回读运行容器；未运行如实报 none
    local web_port web_url="none"
    web_port="$(web_actual_port)"
    [[ -n "$web_port" ]] && web_url="http://localhost:$web_port" || web_port="none"
    final ok 0 project="$PROJECT_NAME" worktree_suffix="$WT_SUFFIX" worktree_source="$WT_IDENTITY_SOURCE" \
      db_credentials="$cred_origin" \
      storage_credentials="$storage_cred_origin" \
      locks="$(ls -1 "$LOCK_ROOT" 2>/dev/null | grep '\.lock$' | paste -sd, - || true)" \
      leases="$leases" \
      web_port="$web_port" web_url="$web_url" \
      node_image="$NODE_IMAGE" db_image="$DB_IMAGE_EFFECTIVE" db_image_source="$DB_IMAGE_SOURCE" \
      redis_image="$REDIS_IMAGE" rustfs_image="$RUSTFS_IMAGE" \
      snapshot_hash="${STATE_SNAPSHOT_HASH:-none}" workspace_image_id="${STATE_IMAGE_ID:-none}" \
      tools_image_id="${STATE_TOOLS_IMAGE_ID:-none}"
    return 0
  fi
  note "worktree：project=${PROJECT_NAME}（suffix=${WT_SUFFIX}；身份来源：${WT_IDENTITY_SOURCE}）"
  note "容器（本项目）："
  cmd_ps
  # web 实际宿主端口（#62）：按本 worktree 项目标签回读；per-worktree 可查询
  local web_port
  web_port="$(web_actual_port)"
  if [[ -n "$web_port" ]]; then
    note "web：http://localhost:${web_port}（宿主 $web_port → 容器 4173；零宿主端口唯一例外）"
  else
    note "web：未运行（启动：devenv web——省略 --port 时引擎自动分配空闲端口）"
  fi
  note "锁（${LOCK_ROOT}，机器级命名空间；本 worktree 锁名 stack-$WT_SUFFIX / migrate-${WT_SUFFIX}，机器级 lockgen/prefetch）："
  ls -1 "$LOCK_ROOT" 2>/dev/null | grep '\.lock$' | sed 's/^/  /' >&2 || true
  note "栈使用租约（#61；active=持有进程存活，stale=已死待下次取得清理）："
  local lease_lines=""
  lease_lines="$(lease_report_all)"
  if [[ -n "$lease_lines" ]]; then
    printf '%s\n' "$lease_lines" | sed 's/^/  /' >&2
  else
    printf '  无\n' >&2
  fi
  images_load
  snapshot_state_load
  note "镜像：node=$NODE_IMAGE"
  note "镜像：db=${DB_IMAGE_EFFECTIVE}（来源：${DB_IMAGE_SOURCE}）"
  note "镜像 tag：tools=$TOOLS_IMAGE workspace=${WS_IMAGE}（per-worktree；运行绑定不可变 ID）"
  note "快照：${STATE_SNAPSHOT_HASH:-无}"
  note "绑定：workspace=${STATE_IMAGE_ID:-无} tools=${STATE_TOOLS_IMAGE_ID:-无}"
}

cmd_supply_chain() {
  local container=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --container) container=1; shift;;
      *) die 2 "未知参数：$1（用法：supply-chain [--container]）";;
    esac
  done
  if ! supply_chain_static_check "$REPO_ROOT" 0; then
    local e
    for e in ${SC_ERRORS[@]+"${SC_ERRORS[@]}"}; do ev supply_chain.error message="$e"; done
    sc_print_report
    final failed 4 errors="$(sc_error_count)" hints="docs/agents/supply-chain.md"
    die 4 "供应链门禁未通过（$(sc_error_count) 项）。规则与例外流程：docs/agents/supply-chain.md"
  fi
  if (( container )); then
    # 容器内权限门禁会确保快照 workspace 镜像存在（读状态/可能构建），与
    # build/up/down 同属复合写过程：持 per-worktree 栈排他锁（COMMANDS 并发表），
    # 避免与同 worktree 的 down/build/测试租约竞争镜像标签与状态文件。
    engine_init
    lock_acquire "stack-$WT_SUFFIX" 120
    ensure_fresh_workspace
    local prc=0
    in_tools bash /workspace/devenv/supply-chain/check-permissions.sh >&2 || prc=$?
    if (( prc )); then
      final failed 4 step="supply-chain-permissions" taskRc="$prc" hint="docs/agents/supply-chain.md"
      die 4 "供应链权限门禁未通过：存在待审批的构建脚本/包内 agent skills（默认不自动采纳）。审查后显式批准/拒绝（pnpm approve 或 permissions.*）"
    fi
    note "容器内权限门禁通过（无待审批项）"
  fi
  note "供应链门禁通过（catalog 精确 pin / allowBuilds 版本化 / 冷却期 / 锁文件一致 / 镜像锁 digest）"
  final ok 0 errors=0 warnings="$(sc_warning_count)"
}

cmd_images() {
  images_load
  if [[ "${1:-}" == "--verify" ]]; then
    # 上游镜像运行态核对（Spec §2）：db 运行容器 digest + tools 基座 node label。
    # 多架构镜像锁 manifest-list digest；单架构镜像锁平台摘要——两者都要求运行态
    # 的 RepoDigests 命中锁值（podman/docker 对 manifest-list 拉取均记录该 digest）。
    note "生效 DB 镜像：${DB_IMAGE_EFFECTIVE}（来源：${DB_IMAGE_SOURCE}）"
    ev images.effective image="$DB_IMAGE_EFFECTIVE" source="$DB_IMAGE_SOURCE" \
      kind="$DB_IMAGE_KIND_EFFECTIVE" platform="$DB_IMAGE_PLATFORM_EFFECTIVE"
    local rc=0 cid img digests running lock_sha label tools_ref tools_ok=0
    # --- db ---
    lock_sha="${DB_IMAGE_EFFECTIVE##*@}"
    if [[ "$lock_sha" == "$DB_IMAGE_EFFECTIVE" ]]; then
      (( JSON )) && printf '{"service":"db","result":"no-digest-in-ref","ref":"%s"}\n' "$(jstr "$DB_IMAGE_EFFECTIVE")" \
        || warn "db 生效引用无 digest（${DB_IMAGE_EFFECTIVE}），无法 digest 级校验"
      rc=1
    else
      cid="$(svc_container_id db)"
      if [[ -z "$cid" ]]; then
        (( JSON )) && printf '{"service":"db","result":"not-running"}\n' || warn "db: 未运行（修复：devenv up）"
        rc=1
      else
        img="$(docker inspect "$cid" --format '{{.Image}}')"
        digests="$(docker image inspect "$img" --format '{{json .RepoDigests}}' 2>/dev/null || printf '[]')"
        if printf '%s' "$digests" | jq -e --arg d "$lock_sha" 'map(split("@")[-1]) | index($d) != null' >/dev/null 2>&1; then
          (( JSON )) && printf '{"service":"db","result":"ok","digest":"%s"}\n' "$lock_sha" \
            || note "db: ok（${lock_sha}；kind=${DB_IMAGE_KIND_EFFECTIVE}${DB_IMAGE_PLATFORM_EFFECTIVE:+ platform=${DB_IMAGE_PLATFORM_EFFECTIVE}}）"
        else
          running="$(printf '%s' "$digests" | jq -r '[.[] | split("@")[-1]] | join(",")' 2>/dev/null || printf '%s' "$digests")"
          (( JSON )) && printf '{"service":"db","result":"drift","locked":"%s","running":"%s"}\n' \
            "$lock_sha" "$(jstr "$running")" \
            || warn "db: 漂移（锁=${lock_sha}，运行=${running}）。修复：devenv down && devenv up"
          rc=1
        fi
      fi
    fi
    # --- node（tools 基座）---
    # 直接运行态是 db；node 以上游基座身份进入 tools/workspace 镜像，经构建期 label
    # 核对（tools.Dockerfile: LABEL devenv.node.image="${NODE_IMAGE}"）。
    tools_ref="$TOOLS_IMAGE"
    if label="$(docker image inspect "$tools_ref" --format '{{index .Config.Labels "devenv.node.image"}}' 2>/dev/null)"; then
      tools_ok=1
    else
      snapshot_state_load
      tools_ref="${STATE_TOOLS_IMAGE_ID:-}"
      if [[ -n "$tools_ref" ]] && label="$(docker image inspect "$tools_ref" --format '{{index .Config.Labels "devenv.node.image"}}' 2>/dev/null)"; then
        tools_ok=1
      fi
    fi
    if (( ! tools_ok )); then
      (( JSON )) && printf '{"service":"node","result":"not-built"}\n' || warn "node: tools 镜像未构建（修复：devenv build）"
      rc=1
    elif [[ -z "$label" ]]; then
      (( JSON )) && printf '{"service":"node","result":"unverifiable","reason":"label-missing"}\n' \
        || warn "node: tools 镜像缺 devenv.node.image label（旧构建；修复：devenv build 后重试）"
      rc=1
    elif [[ "$label" == "$NODE_IMAGE" ]]; then
      (( JSON )) && printf '{"service":"node","result":"ok","locked":"%s"}\n' "$(jstr "$NODE_IMAGE")" \
        || note "node: ok（${NODE_IMAGE}；kind=${NODE_IMAGE_KIND}）"
    else
      (( JSON )) && printf '{"service":"node","result":"drift","locked":"%s","label":"%s"}\n' \
        "$(jstr "$NODE_IMAGE")" "$(jstr "$label")" \
        || warn "node: 漂移（锁=${NODE_IMAGE}，tools label=${label}）。修复：devenv build"
      rc=1
    fi
    exit "$rc"
  fi
  # 人读/机读双用：非 --json 猫锁文件原文 + 生效值；--json 只放结构化结果（不混原文进结果流）
  if (( JSON )); then
    printf '{"node_image":"%s","node_kind":"%s","db_image":"%s","db_kind":"%s","db_platform":"%s","source":"%s","db_macos":"%s","db_macos_kind":"%s","playwright_image":"%s","playwright_kind":"%s","playwright_version":"%s"}\n' \
      "$(jstr "$NODE_IMAGE")" "$(jstr "$NODE_IMAGE_KIND")" "$(jstr "$DB_IMAGE_EFFECTIVE")" \
      "$(jstr "$DB_IMAGE_KIND_EFFECTIVE")" "$(jstr "$DB_IMAGE_PLATFORM_EFFECTIVE")" \
      "$(jstr "$DB_IMAGE_SOURCE")" "$(jstr "$DB_IMAGE_MACOS")" "$(jstr "$DB_IMAGE_MACOS_KIND")" \
      "$(jstr "$PLAYWRIGHT_IMAGE")" "$(jstr "$PLAYWRIGHT_IMAGE_KIND")" "$(jstr "$PLAYWRIGHT_VERSION")"
  else
    cat "$IMAGES_LOCK"
    note "生效 DB 镜像：${DB_IMAGE_EFFECTIVE}（来源：${DB_IMAGE_SOURCE}；kind=${DB_IMAGE_KIND_EFFECTIVE}${DB_IMAGE_PLATFORM_EFFECTIVE:+ platform=${DB_IMAGE_PLATFORM_EFFECTIVE}}）"
    note "macOS/arm64 路线登记：${DB_IMAGE_MACOS}（kind=${DB_IMAGE_MACOS_KIND}；引擎架构 arm64 时自动生效，DEVENV_DB_IMAGE 可显式覆盖）"
  fi
}

# ---------------------------------------------------------------------------
# 分支保护两层规则集漂移核对（#73；不触引擎；只读 GitHub）
# ---------------------------------------------------------------------------
cmd_branch_protection() {
  local require_bypass=0 mode_note=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verify) shift ;;  # 兼容同义旗标（核对即默认行为）
      --require-bypass-actors) require_bypass=1; shift ;;
      *) die 2 "branch-protection 不接受参数：$1（可用：--require-bypass-actors）" ;;
    esac
  done
  if [[ $require_bypass == 1 && -z "${BP_GITHUB_TOKEN:-${GITHUB_TOKEN:-}}" ]]; then
    die 2 "--require-bypass-actors 需要管理员读取凭据：BP_GITHUB_TOKEN=<管理员令牌>（bypass_actors 仅对规则集写权限者可见）"
  fi
  [[ $require_bypass == 1 ]] && mode_note="，管理员强校验绕过名单"
  BP_FINDINGS=(); BP_NOTES=()
  [[ $require_bypass == 1 ]] && export BP_REQUIRE_BYPASS_ACTORS=1
  note "核对 Git 保护配置（${BP_DURABLE_RULESETS[*]} + 合入后自动删除设置）：保存配置 devenv/rulesets/ ↔ GitHub 实时（只读${mode_note}）"
  ev bp.start scope=dev+archive+auto-delete rulesets="${BP_DURABLE_RULESETS[*]}" require_bypass="$require_bypass"
  local rc=0 rc_settings=0
  bp_check_drift ${BP_DURABLE_RULESETS[@]+"${BP_DURABLE_RULESETS[@]}"} || rc=$?
  bp_check_repo_settings || rc_settings=$?
  unset BP_REQUIRE_BYPASS_ACTORS 2>/dev/null || true
  # 优先级合并：3（无法核查）> 1（漂移）> 0
  rc=$(bp_merge_rc "$rc" "$rc_settings")
  local f n=0
  for f in ${BP_FINDINGS[@]+"${BP_FINDINGS[@]}"}; do
    warn "$f"
    ev bp.finding text="$f"
    n=$((n + 1))
  done
  local m=0
  for f in ${BP_NOTES[@]+"${BP_NOTES[@]}"}; do
    note "$f"
    ev bp.note text="$f"
    m=$((m + 1))
  done
  case "$rc" in
    0) note "一致：远端规则集与保存配置逐字段相同（绕过名单 ${m} 项未核对面见 NOTE），且无额外规则集覆盖 dev"
        final ok 0 findings=0 notes="$m" ;;
    1) warn "漂移：$n 项发现（见上；修复：按 docs/agents/branch-protection.md 同步 UI 与保存配置）"
        final failed 1 findings="$n" notes="$m" ;;
    *) warn "无法核查（fetch/解析失败，fail closed，不判一致）：$n 项发现"
        final failed "$rc" findings="$n" notes="$m" ;;
  esac
  exit "$rc"
}

# ---------------------------------------------------------------------------
# 分支清理（#74；不触引擎；窄用途「PR 合入后清理」，无强制删除路径）
# ---------------------------------------------------------------------------
cmd_branch_cleanup() {
  local branch="" apply=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply) apply=1; shift ;;
      --force|-f) die 2 "branch-cleanup 不存在强制删除路径（--force 被拒绝）：发现未保存工作一律拒绝并列出原因" ;;
      --*) die 2 "branch-cleanup 未知旗标：$1（可用：--apply）" ;;
      *) [[ -z "$branch" ]] || die 2 "branch-cleanup 只接受一个分支参数（多余：$1）"; branch="$1"; shift ;;
    esac
  done
  [[ -n "$branch" ]] || die 2 "branch-cleanup 需要分支参数：devenv branch-cleanup <branch> [--apply]"
  bc_branch_exists "$branch" || die 2 "本地分支不存在：$branch"

  ev bc.start branch="$branch" apply="$apply"
  local rc=0
  bc_judge "$branch" || rc=$?
  local r n=0
  for r in ${BC_REASONS[@]+"${BC_REASONS[@]}"}; do
    warn "$r"; ev bc.reason text="$r"; n=$((n + 1))
  done

  if [[ $rc != 0 ]]; then
    case "$rc" in
      3) warn "无法判定（fail closed，不删除）：$n 项原因" ;;
      6) warn "目标 worktree 持有活跃栈锁/租约（exit 6，绝不强拆）：$n 项原因" ;;
      *) warn "拒绝清理分支 $branch：$n 项原因（见上；不存在强制删除路径）" ;;
    esac
    final failed "$rc" branch="$branch" reasons="$n" pr="${BC_PR_NUMBER:-}" merged_head="${BC_MERGED_HEAD:-}"
    exit "$rc"
  fi

  # 判定通过：dry-run 报告 / --apply 删除（worktree + 分支）
  local wt_note="${BC_WORKTREE:-无}"
  if [[ $apply == 0 ]]; then
    note "可安全清理（dry-run，未删除）：分支 $branch（worktree=$wt_note；PR #${BC_PR_NUMBER:-?} 已合入；合入 head=$BC_MERGED_HEAD；squash 提交=${BC_MERGE_COMMIT:-?}）。加 --apply 执行删除。"
    final ok 0 branch="$branch" action=dry-run worktree="$wt_note" pr="${BC_PR_NUMBER:-}" \
      merged_head="$BC_MERGED_HEAD" merge_commit="${BC_MERGE_COMMIT:-}" reasons=0
    exit 0
  fi
  # 关闭判定→删除 TOCTOU：删除前再核 tip 仍为判定基准 BC_TIP（并发改动即拒绝）
  local now_tip
  now_tip=$(git -C "$REPO_ROOT" rev-parse --verify "refs/heads/$branch" 2>/dev/null) || now_tip=""
  [[ "$now_tip" == "$BC_TIP" ]] || die 4 "分支 $branch 在判定后被修改（tip ${now_tip:-?} ≠ 判定基准 $BC_TIP）——拒绝删除，请重新判定"
  if [[ -n "$BC_WORKTREE" ]]; then
    git -C "$REPO_ROOT" worktree remove "$BC_WORKTREE" || die 4 "worktree 移除失败：$BC_WORKTREE（判定已通过但删除失败，现场保留）"
  fi
  # 原子 compare-and-delete：仅当 ref 仍等于判定基准 BC_TIP 时删除（并发新增提交即失败，不强删）
  git -C "$REPO_ROOT" update-ref -d "refs/heads/$branch" "$BC_TIP" || die 4 "分支删除失败：$branch（ref 已变动或删除失败，现场保留）"
  note "已清理：分支 $branch（worktree=$wt_note 已移除；PR #${BC_PR_NUMBER:-?} 合入 head=$BC_MERGED_HEAD；squash 提交=${BC_MERGE_COMMIT:-?}）"
  final ok 0 branch="$branch" action=cleaned worktree="$wt_note" pr="${BC_PR_NUMBER:-}" \
    merged_head="$BC_MERGED_HEAD" merge_commit="${BC_MERGE_COMMIT:-}" reasons=0
  exit 0
}

